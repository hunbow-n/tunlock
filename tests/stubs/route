#!/bin/bash
# One kernel route for every exception address: $STUB/kernel_route "iface gw".
case $2 in
  get) read -r i g < "$STUB/kernel_route"; echo "  interface: $i"; [[ -z $g ]] || echo "    gateway: $g" ;;
  add) echo "en0 $5" > "$STUB/kernel_route"; echo "add $4 $5 ${*:6}" >> "$STUB/route.log" ;;
  delete) echo "delete $4 $5" >> "$STUB/route.log" ;;
esac
