<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>tunlock.ssh</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>@PREFIX@/libexec/tunlock/tunlock</string>
		<string>ssh-run</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>5</integer>
	<key>StandardOutPath</key>
	<string>@HOME@/Library/Logs/tunlock-ssh.log</string>
	<key>StandardErrorPath</key>
	<string>@HOME@/Library/Logs/tunlock-ssh.log</string>
</dict>
</plist>
