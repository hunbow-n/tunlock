#!/bin/bash
# tunlock: keep an SSH tunnel to your own server up and let traffic leave
# a Mac only through a verified tunnel. Fails closed: when the tunnel, the
# TUN client or the egress check fails, the internet stays blocked until
# the path is verified again or you choose direct mode yourself.
set -euo pipefail
# tunlock run starts the user's command with the user's own PATH.
USER_PATH=$PATH
export PATH=/usr/bin:/bin:/usr/sbin:/sbin
# Tests swap system tools for stubs. Root never sees this: sudo and launchd
# start with a clean environment.
if [[ -n ${TUNLOCK_TEST_PATH:-} && $EUID != 0 ]]; then PATH=$TUNLOCK_TEST_PATH:$PATH; fi

VERSION=0.1.0
PREFIX=${TUNLOCK_PREFIX:-/usr/local}
CONF=${TUNLOCK_CONF:-$PREFIX/etc/tunlock.conf}
STATE_DIR=${TUNLOCK_STATE_DIR:-/var/db/tunlock}  # persistent: chosen mode
RUN_DIR=${TUNLOCK_RUN_DIR:-/var/run/tunlock}     # cleared at boot: live state
RESOLVER_DIR=${TUNLOCK_RESOLVER_DIR:-/etc/resolver}
RESOLVER_MARK='# managed by tunlock'
# Hosts behind Cloudflare whose own /cdn-cgi/trace tells which IP reached them.
AI_HOSTS=${TUNLOCK_AI_HOSTS:-"claude.ai api.anthropic.com chatgpt.com"}
# AI clients that keep a session open and would reconnect directly once off.
AI_APPS=${TUNLOCK_AI_APPS:-"claude Claude codex ChatGPT Cursor"}
GUARD_LABEL=tunlock.guard
SSH_LABEL=tunlock.ssh
TICK=2

die() { echo "tunlock: $*" >&2; exit 1; }
log() { echo "$(date '+%Y-%m-%d %H:%M:%S') $*"; }
is_ipv4() {
  [[ $1 =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
  local i
  for i in 1 2 3 4; do (( BASH_REMATCH[i] <= 255 )) || return 1; done
}
is_port() { [[ $1 =~ ^[0-9]{1,5}$ ]] && (( $1 >= 1 && $1 <= 65535 )); }

# ---------------------------------------------------------------- config

CONFIG_KEYS='UPSTREAM PROXY_HOST PROXY_PORT VPS_IP SSH_HOST SSH_PORT SSH_USER SSH_IDENTITY SSH_FORWARD JUMP_HOST JUMP_USER JUMP_PORT BYPASS_NETS BYPASS_DNS AI_NETS TUN_ADDR TUN_MASK TUN_SERVICE EXPECTED_EGRESS EXPECTED_COUNTRY PROBE_URL PROBE_INTERVAL PF_ANCHOR'

# Parse KEY=value lines without sourcing: the guard runs as root.
load_config() {
  [[ -r $CONF ]] || die "config not found: $CONF (copy tunlock.conf.example there)"
  local key line n=0 val
  for key in $CONFIG_KEYS; do printf -v "$key" '%s' ''; done
  while IFS= read -r line || [[ -n $line ]]; do
    n=$((n + 1))
    [[ $line =~ ^[[:space:]]*(#.*)?$ ]] && continue
    [[ $line =~ ^[[:space:]]*([A-Z_]+)=(.*)$ ]] || die "$CONF:$n: expected KEY=value"
    key=${BASH_REMATCH[1]}
    val=${BASH_REMATCH[2]}
    val=${val%%[[:space:]]#*}
    val=${val%"${val##*[![:space:]]}"}
    if [[ $val =~ ^\"(.*)\"$ || $val =~ ^\'(.*)\'$ ]]; then val=${BASH_REMATCH[1]}; fi
    [[ " $CONFIG_KEYS " == *" $key "* ]] || die "$CONF:$n: unknown key $key"
    printf -v "$key" '%s' "$val"
  done < "$CONF"

  : "${UPSTREAM:=ssh}" "${PROBE_URL:=https://1.1.1.1/cdn-cgi/trace}" "${PROBE_INTERVAL:=30}"
  : "${PF_ANCHOR:=com.apple/000.tunlock}"
  is_ipv4 "$TUN_ADDR" || die "TUN_ADDR must be the IPv4 address of your TUN interface"

  # Two ways the TUN client reaches the outside:
  #   ssh    through an SSH forward that tunlock keeps up (own server, optional relay)
  #   proxy  the TUN client connects straight to a proxy (HTTP/SOCKS/...);
  #          tunlock runs no SSH and never sees the proxy's credentials
  case $UPSTREAM in
    proxy)
      is_ipv4 "$PROXY_HOST" || die "PROXY_HOST must be the proxy's IPv4 address: DNS is blocked while protected"
      is_port "$PROXY_PORT" || die "PROXY_PORT is not a port"
      : "${EXPECTED_EGRESS:=$PROXY_HOST}"
      check_expected
      ENTRY_HOST=$PROXY_HOST ENTRY_PORT=$PROXY_PORT
      FORWARD_ARGS=() HEALTH_HOST='' HEALTH_PORT=''
      parse_common
      return
      ;;
    ssh) ;;
    *) die "UPSTREAM must be ssh or proxy" ;;
  esac
  : "${SSH_HOST:=$VPS_IP}" "${EXPECTED_EGRESS:=$VPS_IP}" "${SSH_PORT:=22}"
  : "${JUMP_USER:=$SSH_USER}" "${JUMP_PORT:=22}"
  is_ipv4 "$VPS_IP" || die "VPS_IP must be an IPv4 address"
  is_ipv4 "$SSH_HOST" || die "SSH_HOST must be an IPv4 address: DNS is blocked while protected"
  check_expected
  is_port "$SSH_PORT" || die "SSH_PORT is not a port"
  # Cascade: SSH enters through JUMP_HOST and reaches SSH_HOST from there.
  # Only the entry is reachable outside the tunnel; egress stays EXPECTED_EGRESS.
  if [[ -n $JUMP_HOST ]]; then
    is_ipv4 "$JUMP_HOST" || die "JUMP_HOST must be an IPv4 address: DNS is blocked while protected"
    is_port "$JUMP_PORT" || die "JUMP_PORT is not a port"
    [[ $JUMP_USER =~ ^[A-Za-z_][A-Za-z0-9._-]*$ ]] || die "JUMP_USER is invalid"
    ENTRY_HOST=$JUMP_HOST ENTRY_PORT=$JUMP_PORT
  else
    ENTRY_HOST=$SSH_HOST ENTRY_PORT=$SSH_PORT
  fi
  # Goes into a ProxyCommand line, so keep it to plain path characters.
  [[ -z $SSH_IDENTITY || $SSH_IDENTITY =~ ^[~A-Za-z0-9._/-]+$ ]] || die "SSH_IDENTITY: use a path without spaces"
  [[ $SSH_USER =~ ^[A-Za-z_][A-Za-z0-9._-]*$ ]] || die "SSH_USER is missing or invalid"
  parse_forward
  parse_common
}

# Settings shared by both upstreams.
parse_common() {
  parse_bypass
  parse_ai_nets
  # Name of the TUN client's VPN service in "scutil --nc list" (e.g. Karing):
  # optional; when set, on/off also start and stop it.
  [[ -z $TUN_SERVICE || $TUN_SERVICE =~ ^[A-Za-z0-9\ ._()-]+$ ]] || die "TUN_SERVICE: use the name from scutil --nc list"
  [[ -z $TUN_MASK || $TUN_MASK =~ ^0x[0-9a-f]{8}$ ]] || die "TUN_MASK must look like 0xfffffffc"
  TUN_NET=$(tun_net "$TUN_MASK")
  [[ $PROBE_INTERVAL =~ ^[0-9]+$ ]] && (( PROBE_INTERVAL >= 5 )) || die "PROBE_INTERVAL must be >= 5"
  [[ $PF_ANCHOR =~ ^[A-Za-z0-9._/-]+$ ]] || die "PF_ANCHOR is invalid"
  PROBE_IP=''
  [[ $PROBE_URL =~ ^https://([0-9.]+)(/[A-Za-z0-9._/~-]*)?$ ]] && PROBE_IP=${BASH_REMATCH[1]}
  is_ipv4 "$PROBE_IP" || die "PROBE_URL must be https:// with an IPv4 literal host"
}

# What a verified exit is:
#   EXPECTED_EGRESS   one IPv4 (pinned exit), or "any" to accept any address
#   EXPECTED_COUNTRY  two-letter country code from the probe, e.g. US; optional
# "any" needs a country: otherwise nothing would be checked at all.
check_expected() {
  EXPECTED_COUNTRY=$(tr '[:lower:]' '[:upper:]' <<< "$EXPECTED_COUNTRY")
  [[ -z $EXPECTED_COUNTRY || $EXPECTED_COUNTRY =~ ^[A-Z]{2}$ ]] || die "EXPECTED_COUNTRY must be a two-letter code like US"
  if [[ $EXPECTED_EGRESS == any ]]; then
    [[ -n $EXPECTED_COUNTRY ]] || die "EXPECTED_EGRESS=any needs EXPECTED_COUNTRY, or nothing would be verified"
  else
    is_ipv4 "$EXPECTED_EGRESS" || die "EXPECTED_EGRESS must be an IPv4 address or any"
  fi
}

# egress_matches ip country: does this probe answer count as our exit?
egress_matches() {
  [[ -n $1 ]] || return 1
  [[ $EXPECTED_EGRESS == any || $1 == "$EXPECTED_EGRESS" ]] || return 1
  [[ -z $EXPECTED_COUNTRY || $2 == "$EXPECTED_COUNTRY" ]]
}

# "203.0.113.10 (US)" style description of what is expected.
expected_desc() {
  local ip=$EXPECTED_EGRESS
  [[ $ip == any ]] && ip="any IP"
  echo "$ip${EXPECTED_COUNTRY:+ in $EXPECTED_COUNTRY}"
}

is_cidr() {
  [[ $1 =~ ^([0-9.]+)/([0-9]{1,2})$ ]] || return 1
  local bits=${BASH_REMATCH[2]}
  is_ipv4 "${1%/*}" && (( bits >= 8 && bits <= 32 ))
}

# Exceptions: networks reached directly, around the tunnel, on any port, in
# every phase; and DNS servers for chosen domains (/etc/resolver).
#   BYPASS_NETS="192.168.0.0/24 10.10.0.0/16"
#   BYPASS_DNS="corp.example=192.168.0.1 lab.example=10.10.0.2"
parse_bypass() {
  local item dom ip
  BYPASS_LIST=()
  DNS_DOMAINS=()
  DNS_SERVERS=()
  for item in $BYPASS_NETS; do
    is_cidr "$item" || die "BYPASS_NETS: $item is not an IPv4 network like 192.168.0.0/24"
    BYPASS_LIST+=("$item")
  done
  for item in $BYPASS_DNS; do
    dom=${item%%=*}
    ip=${item#*=}
    [[ $item == *=* && $dom =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$ ]] \
      || die "BYPASS_DNS: $item must look like corp.example=192.168.0.1"
    is_ipv4 "$ip" || die "BYPASS_DNS: $ip is not an IPv4 address"
    DNS_DOMAINS+=("$dom")
    DNS_SERVERS+=("$ip")
  done
}

# AI services' own networks, closed outside the tunnel in both modes: off,
# a client can't reach them directly; on, no exception can open them. The
# default holds Anthropic's (ARIN: Anthropic, PBC), where api.anthropic.com,
# claude.ai and claude.com live. AI_NETS=none turns it off.
DEFAULT_AI_NETS="160.79.104.0/21 2607:6bc0::/32"
is_cidr6() {
  [[ $1 =~ ^([0-9a-fA-F:]+)/([0-9]{1,3})$ && ${BASH_REMATCH[1]} == *:*:* ]] || return 1
  local bits=${BASH_REMATCH[2]}
  (( bits >= 16 && bits <= 128 ))
}
parse_ai_nets() {
  local item
  AI4=() AI6=()
  [[ -n $AI_NETS ]] || AI_NETS=$DEFAULT_AI_NETS
  [[ $AI_NETS != none ]] || return 0
  for item in $AI_NETS; do
    if is_cidr "$item"; then AI4+=("$item")
    elif is_cidr6 "$item"; then AI6+=("$item")
    else die "AI_NETS: $item is not a network like 160.79.104.0/21 or 2607:6bc0::/32 (or none)"
    fi
  done
}
ai_closing() { (( ${#AI4[@]} + ${#AI6[@]} > 0 )); }

# SSH_FORWARD holds -L/-D options, e.g. "-L 127.0.0.1:1080:127.0.0.1:8388".
# The first one gives the local port that health checks look at.
parse_forward() {
  local words opt spec i
  read -r -a words <<< "$SSH_FORWARD"
  (( ${#words[@]} >= 2 && ${#words[@]} % 2 == 0 )) || die "SSH_FORWARD needs -L or -D options"
  FORWARD_ARGS=()
  HEALTH_HOST=''
  HEALTH_PORT=''
  for (( i = 0; i < ${#words[@]}; i += 2 )); do
    opt=${words[i]}
    spec=${words[i + 1]}
    [[ $opt == -L || $opt == -D ]] || die "SSH_FORWARD: unsupported option $opt"
    [[ $spec =~ ^[A-Za-z0-9._:-]+$ ]] || die "SSH_FORWARD: invalid spec $spec"
    FORWARD_ARGS+=("$opt" "$spec")
    [[ -z $HEALTH_PORT ]] || continue
    local f
    IFS=: read -r -a f <<< "$spec"
    case "$opt:${#f[@]}" in
      -L:3 | -D:1) HEALTH_HOST=127.0.0.1; HEALTH_PORT=${f[0]} ;;
      -L:4 | -D:2) HEALTH_HOST=${f[0]}; HEALTH_PORT=${f[1]} ;;
      *) die "SSH_FORWARD: cannot read the local port of $spec" ;;
    esac
    case $HEALTH_HOST in '' | '*' | localhost | 0.0.0.0) HEALTH_HOST=127.0.0.1 ;; esac
    is_port "$HEALTH_PORT" || die "SSH_FORWARD: bad local port in $spec"
  done
}

# ---------------------------------------------------------------- network

# awk reads netstat to the end: exiting early can SIGPIPE netstat, and with
# pipefail that ends the guard (#45).
physical_iface() {
  netstat -rn -f inet | awk '$1 == "default" && $4 ~ /^en[0-9]+$/ && !n++ { print $4 }'
}

# Tests feed a recorded ifconfig output through TUNLOCK_TEST_IFCONFIG.
ifconfig_dump() {
  if [[ -n ${TUNLOCK_TEST_IFCONFIG:-} ]]; then cat "$TUNLOCK_TEST_IFCONFIG"; else ifconfig -a; fi
}

physical_gateway() {
  netstat -rn -f inet | awk '$1 == "default" && $4 ~ /^en[0-9]+$/ && !n++ { print $2 }'
}

# The utun number changes between connects, so find it by its address.
find_tun() { find_tun_mask | awk '{ print $1 }'; }

# "utunN 0xffffff.." for the utun carrying TUN_ADDR.
find_tun_mask() {
  ifconfig_dump | awk -v ip="$TUN_ADDR" -v mask="$TUN_MASK" '
    /^[a-z]/ { sub(/:.*/, "", $1); ifc = $1; next }
    ifc ~ /^utun[0-9]+$/ && $1 == "inet" && $2 == ip && (mask == "" || $NF == mask) {
      print ifc, $NF; exit
    }'
}

# The TUN client's own subnet (TUN_ADDR with a hex mask), e.g. 10.20.0.0/30.
# System-stack TUN clients (sing-box, Karing) rewrite each connection to a
# peer address inside it, so even the probe's packets travel within it.
tun_net() {
  local mask=$1 m a b c d bits
  [[ $mask =~ ^0x[0-9a-f]{8}$ ]] || { echo "$TUN_ADDR/32"; return; }
  m=$(( 16#${mask#0x} ))
  IFS=. read -r a b c d <<< "$TUN_ADDR"
  bits=0
  local x=$m
  while (( x & 0x80000000 )); do bits=$((bits + 1)); x=$(( (x << 1) & 0xffffffff )); done
  echo "$(( a & (m >> 24 & 255) )).$(( b & (m >> 16 & 255) )).$(( c & (m >> 8 & 255) )).$(( d & (m & 255) ))/$bits"
}

# Ask a fixed IP (no DNS) which address we come from, through the tunnel.
probe_egress() {
  curl -4fsS --noproxy '*' --interface "$TUN_ADDR" --connect-timeout 4 --max-time 6 \
    "$PROBE_URL" 2>/dev/null | awk -F= '$1 == "ip" { ip = $2 } $1 == "loc" { loc = $2 } END { if (ip != "") print ip, loc }'
}

ssh_up() { nc -z -G 1 "$HEALTH_HOST" "$HEALTH_PORT" >/dev/null 2>&1; }

# Is the SSH entry reachable outside the tunnel? Bound to the physical
# interface, or the check would travel through the tunnel itself.
entry_up() {
  local phys
  phys=$(physical_iface)
  [[ -n $phys ]] && nc -z -G 2 -b "$phys" "$ENTRY_HOST" "$ENTRY_PORT" >/dev/null 2>&1
}

# ---------------------------------------------------------------- pf rules

# Phases while protected:
#   block  no TUN interface found: only SSH entry, DHCP, loopback, exceptions
#   probe  TUN found, egress not verified: only the HTTPS probe may use it
#   open   egress verified: everything from the TUN address may leave
# Every phase ends in "block drop quick all", IPv6 included. That rule carries
# a label with a hash of the set, so the guard can confirm pf holds exactly it.
render_rules() {
  local phase=$1 ifc=${2:-} phys=${3:-} body
  [[ -z $phys || $phys =~ ^en[0-9]+$ ]] || die "render_rules: bad physical interface $phys"
  case $phase in
    direct)
      # Off: only the AI networks are closed, everywhere; the rest is direct.
      ai_closing || die "render_rules: AI_NETS=none leaves nothing for direct mode"
      body=$(render_ai_block '')
      local label
      label="label \"tunlock-$(md5 -q -s "$body" | cut -c1-12)\""
      echo "# tunlock $VERSION phase=direct"
      echo "${body//$'\n'/ $label$'\n'} $label"
      return ;;
    block) ;;
    probe | open) [[ $ifc =~ ^utun[0-9]+$ ]] || die "render_rules: bad interface $ifc" ;;
    *) die "render_rules: unknown phase $phase" ;;
  esac
  body=$(render_body "$phase" "$ifc" "$phys")
  echo "# tunlock $VERSION phase=$phase"
  echo "$body"
  echo "block drop quick all label \"tunlock-$(md5 -q -s "$body" | cut -c1-12)\""
}

render_body() {
  local phase=$1 ifc=$2 phys=$3 item
  echo "pass quick on lo0 all no state"
  # Before any pass: no entry or exception reaches the AI networks directly.
  render_ai_block "$ifc"
  echo "pass out quick inet proto tcp to $ENTRY_HOST port $ENTRY_PORT flags any keep state (if-bound)"
  # A proxy may also carry UDP (SOCKS5 UDP associate, QUIC-capable protocols).
  [[ $UPSTREAM != proxy ]] || echo "pass out quick inet proto udp to $ENTRY_HOST port $ENTRY_PORT keep state (if-bound)"
  echo "pass out quick inet proto udp from any port 68 to any port 67 no state"
  echo "pass in quick inet proto udp from any port 67 to any port 68 no state"
  # Exceptions leave only through the physical interface, never another tunnel.
  if [[ -n $phys ]]; then
    for item in ${BYPASS_LIST[@]+"${BYPASS_LIST[@]}"}; do
      echo "pass out quick on $phys inet from any to $item keep state (if-bound)"
    done
    for item in ${DNS_SERVERS[@]+"${DNS_SERVERS[@]}"}; do
      echo "pass out quick on $phys inet proto { tcp udp } from any to $item port 53 keep state (if-bound)"
    done
  fi
  case $phase in
    probe)
      echo "pass out quick on $ifc inet proto tcp from $TUN_ADDR to $PROBE_IP port 443 no state"
      echo "pass in quick on $ifc inet proto tcp from $PROBE_IP port 443 to $TUN_ADDR no state"
      # The TUN stack's internal leg (e.g. 10.20.0.1 <-> 10.20.0.2). Nothing
      # leaves the Mac this way: apps' own packets still need the rule above.
      if [[ $TUN_NET != "$TUN_ADDR/32" ]]; then
        echo "pass out quick on $ifc inet from $TUN_NET to $TUN_NET no state"
        echo "pass in quick on $ifc inet from $TUN_NET to $TUN_NET no state"
      fi
      ;;
    open)
      echo "pass out quick on $ifc inet from $TUN_ADDR to any no state"
      echo "pass in quick on $ifc inet from any to $TUN_ADDR no state"
      ;;
  esac
}

# AI networks: blocked on every interface but the tunnel (none: everywhere).
render_ai_block() {
  local net on=''
  [[ -z $1 ]] || on="on ! $1 "
  for net in ${AI4[@]+"${AI4[@]}"}; do echo "block drop out quick ${on}inet from any to $net"; done
  for net in ${AI6[@]+"${AI6[@]}"}; do echo "block drop out quick ${on}inet6 from any to $net"; done
}

rules_label() { awk -F'"' '/label "tunlock-/ { l = $2 } END { print l }' <<< "$1"; }

# Read pfctl to the end before matching: grep -q stops at its match, a long
# ruleset then SIGPIPEs pfctl, and with pipefail a match reads as "no" (#45).
pf_anchor_rules() { pfctl -a "$PF_ANCHOR" -sr 2>/dev/null; }
pf_enabled() { local out; out=$(pfctl -s info 2>/dev/null) || return 1; grep -q '^Status: Enabled' <<< "$out"; }
pf_has_label() { local out; [[ -n $1 ]] && out=$(pf_anchor_rules) && grep -qF "label \"$1\"" <<< "$out"; }
pf_rules_live() { local out; out=$(pf_anchor_rules) || return 1; grep -q 'label "tunlock-' <<< "$out"; }
pf_rule_count() { pfctl -a "$PF_ANCHOR" -sr 2>/dev/null | grep -c . || true; }

# Our anchor only runs if the root ruleset reaches it.
pf_anchor_reachable() {
  local parent=${PF_ANCHOR%/*} root
  root=$(pfctl -sr 2>/dev/null)
  if [[ $PF_ANCHOR == */* ]]; then
    grep -qF "anchor \"$parent/*\"" <<< "$root"
  else
    grep -qF "anchor \"$PF_ANCHOR\"" <<< "$root"
  fi
}

# Being reachable is not enough: rules evaluated before our anchor may decide
# first, and then the status would describe rules pf never uses. pf semantics:
#   - a rule marked quick ends evaluation when it matches;
#   - an anchor call marked quick ends evaluation when ANY rule inside it
#     matches, quick or not, nested anchors included.
# Prints one line per conflict found in the root ruleset before the call that
# reaches our anchor, and in sibling anchors that sort before ours.
pf_conflicts() {
  local root line parent=${PF_ANCHOR%/*} mine=${PF_ANCHOR##*/} child reach reach_quick=0
  if [[ $PF_ANCHOR == */* ]]; then reach="anchor \"$parent/*\""; else reach="anchor \"$PF_ANCHOR\""; fi
  root=$(pfctl -sr 2>/dev/null) || { echo "pf did not answer"; return; }
  while IFS= read -r line; do
    if [[ $line == "$reach"* ]]; then
      [[ $line == *" quick"* ]] && reach_quick=1
      break
    fi
    rule_decides_first "$line" 0 0
  done <<< "$root"
  [[ $PF_ANCHOR == */* ]] || return 0
  local siblings
  if ! siblings=$(anchor_children "$parent"); then
    echo "cannot list the anchors under \"$parent\""
    return 0
  fi
  for child in $siblings; do
    [[ ${child##*/} < $mine ]] || continue
    anchor_decides_first "$child" "$reach_quick" 1 && echo "anchor $child sorts before ours"
  done
  return 0
}

# rule_decides_first line inherited_quick depth: prints a conflict if this rule,
# or an anchor it calls, can end evaluation before our anchor.
rule_decides_first() {
  local line=$1 inherited=$2 depth=$3 name q=0 child
  [[ -z $line || $line == scrub* ]] && return 0
  [[ $line == *" quick"* || $inherited == 1 ]] && q=1
  if [[ $line =~ ^anchor\ \"([^\"]+)\" ]]; then
    name=${BASH_REMATCH[1]}
    if [[ $name == */\* ]]; then
      local children
      if ! children=$(anchor_children "${name%/\*}"); then
        echo "cannot list the anchors under \"$name\""
        return 0
      fi
      for child in $children; do
        anchor_decides_first "$child" "$q" "$((depth + 1))" && echo "anchor $child (via \"$name\") is evaluated first"
      done
    elif anchor_decides_first "$name" "$q" "$((depth + 1))"; then
      echo "anchor \"$name\" is evaluated first"
    fi
  elif (( q )); then
    echo "rule evaluated first: $line"
  fi
  return 0
}

# anchor_decides_first name quick_call depth: true if a match inside can end
# evaluation. Deeper than 4 levels counts as a conflict: unknown is not safe.
anchor_decides_first() {
  local name=$1 qcall=$2 depth=$3 rules line
  (( depth <= 4 )) || return 0
  rules=$(pfctl -a "$name" -sr 2>/dev/null) || return 0
  [[ -n $rules ]] || return 1
  (( qcall )) && return 0
  while IFS= read -r line; do
    [[ -n $(rule_decides_first "$line" 0 "$depth") ]] && return 0
  done <<< "$rules"
  return 1
}

# Child anchors of $1. Fails when pf does not answer: an unreadable list is
# not an empty one, so callers report it as a conflict.
anchor_children() {
  local out
  out=$(pfctl -a "$1" -s Anchors 2>/dev/null) || return 1
  awk '{ print $1 }' <<< "$out"
}

ensure_root_ruleset() {
  pf_anchor_reachable && return 0
  if [[ -z $(pfctl -sr 2>/dev/null) ]]; then
    log "root ruleset empty, loading /etc/pf.conf"
    pfctl -f /etc/pf.conf 2>/dev/null || true
  fi
  pf_anchor_reachable
}

# Replacing an anchor's rules is a single transaction: there is no moment
# with an empty anchor, so rebinding to a new utun opens no direct path.
# Succeeds only when pf accepted the set and now reports its label.
pf_apply() {
  local out
  if ! out=$(printf '%s\n' "$1" | pfctl -a "$PF_ANCHOR" -f - 2>&1); then
    G_ERROR="pf rejected the rules: $(grep -v '^No ALTQ' <<< "$out" | head -1)"
    return 1
  fi
  pf_has_label "$(rules_label "$1")" || { G_ERROR="pf did not confirm the new rules"; return 1; }
}

pf_enable_ref() {
  local out token
  out=$(pfctl -E 2>&1) || true
  token=$(awk '/Token/ { print $NF }' <<< "$out")
  [[ -n $token ]] && echo "$token" > "$RUN_DIR/token"
  pf_enabled
}

# Succeeds only when the anchor is confirmed empty. Only then is our pf
# reference released; otherwise the token is kept for the next attempt.
pf_release() {
  local live
  pfctl -a "$PF_ANCHOR" -F rules >/dev/null 2>&1 || true
  # Silence is not proof: pf must answer the read, and without our rules.
  if ! live=$(pfctl -a "$PF_ANCHOR" -sr 2>/dev/null); then
    G_ERROR="pf did not answer; tunlock rules may still be loaded"
    return 1
  fi
  if grep -q 'label "tunlock-' <<< "$live"; then
    G_ERROR="pf did not remove the tunlock rules"
    return 1
  fi
  if [[ -s $RUN_DIR/token ]]; then
    if ! pfctl -X "$(cat "$RUN_DIR/token")" >/dev/null 2>&1; then
      G_ERROR="pf did not release the tunlock reference (token kept)"
      return 1
    fi
  fi
  rm -f "$RUN_DIR/token"
}

# ---------------------------------------------------------------- exceptions

net_probe_ip() {
  local base=${1%/*}
  [[ $1 == */32 ]] && { echo "$base"; return; }
  echo "${base%.*}.$(( ${base##*.} + 1 ))"
}

route_op() { # add|delete net gateway [modifiers]; a /32 is a host route
  local action=$1 target=$2 gateway=$3
  shift 3
  if [[ $target == */32 ]]; then
    route -n "$action" -host "${target%/32}" "$gateway" "$@"
  else
    route -n "$action" -net "$target" "$gateway" "$@"
  fi
}

# Exception networks plus every exception DNS server as a /32: a DNS server
# outside BYPASS_NETS also needs its route around the tunnel.
bypass_targets() {
  local item
  for item in ${BYPASS_LIST[@]+"${BYPASS_LIST[@]}"}; do echo "$item"; done
  for item in ${DNS_SERVERS[@]+"${DNS_SERVERS[@]}"}; do echo "$item/32"; done
}

# "interface gateway source" of a route. The last sockaddr in the reply is
# the interface address when IFA is present; the socket request printed
# before the reply is ignored. Arguments go to route get: an address gives
# the route traffic takes (possibly a host route cloned from ours), -net or
# -host the route for exactly that destination.
route_info() {
  route -n -v get "$@" 2>/dev/null | awk '
    $1 == "interface:" { iface = $2 }
    $1 == "gateway:" { gateway = $2 }
    $1 == "sockaddrs:" && $0 ~ /[<,]IFA>/ {
      if (getline > 0) source = $NF
    }
    END { print iface, gateway, source }
  '
}

# A TUN client in global mode owns the default route. Exception networks need
# a route to the physical gateway. The live kernel route is checked on every
# tick: after sleep or a network change it may have moved to the tunnel even
# when the gateway address stayed the same. Routes added here are recorded in
# $RUN_DIR/routes and are the only ones ever removed.
sync_bypass_routes() {
  local phys gw src net rec keep='' cur_if cur_gw cur_src
  phys=$(physical_iface)
  gw=$(physical_gateway)
  src=''
  if [[ -n $phys ]]; then
    src=$(ifconfig "$phys" 2>/dev/null | awk '$1 == "inet" && !ip { ip = $2 } END { print ip }') || src=''
  fi
  touch "$RUN_DIR/routes"
  for net in $(bypass_targets); do
    [[ $keep != *" $net "* ]] || continue
    keep="$keep $net "
    [[ -n $phys && $gw =~ ^[0-9.]+$ && $src =~ ^[0-9.]+$ ]] || continue
    read -r cur_if cur_gw _ <<< "$(route_info "$(net_probe_ip "$net")")"
    rec=$(awk -v n="$net" '$1 == n { print $2; exit }' "$RUN_DIR/routes")
    if [[ $cur_if == "$phys" && ( -z $cur_gw || $cur_gw == "$gw" || $cur_gw == link#* ) ]]; then
      # A recorded source can disagree with the kernel even on the same
      # interface and gateway. Change only a route that Tunlock recorded,
      # judged by that route itself: traffic may follow a host route cloned
      # from it, which keeps its own source, and would ask for a change on
      # every tick. An unknown source is never a reason to change.
      [[ -n $rec && $cur_gw == "$rec" ]] || continue
      if [[ $net == */32 ]]; then read -r _ _ cur_src <<< "$(route_info -host "${net%/32}")"
      else read -r _ _ cur_src <<< "$(route_info -net "$net")"
      fi
      [[ -n $cur_src && $cur_src != "$src" ]] || continue
      if route_op change "$net" "$gw" -ifp "$phys" -ifa "$src" >/dev/null 2>&1; then
        route_forget "$net"
        echo "$net $gw $phys $src" >> "$RUN_DIR/routes"
        log "exception rebound: $net via $gw ($phys, $src)"
      else
        G_WARNING="could not refresh the exception route for $net"
      fi
      continue
    fi
    if [[ -n $rec ]]; then
      if ! route_op delete "$net" "$rec" >/dev/null 2>&1 && [[ $cur_if == "$phys" && $cur_gw == "$rec" ]]; then
        G_WARNING="could not refresh the exception route for $net"
        continue
      fi
      route_forget "$net"
    fi
    if route_op add "$net" "$gw" -ifp "$phys" -ifa "$src" >/dev/null 2>&1; then
      echo "$net $gw $phys $src" >> "$RUN_DIR/routes"
      log "exception: $net via $gw ($phys, $src)"
    fi
    read -r cur_if _ <<< "$(route_info "$(net_probe_ip "$net")")"
    [[ $cur_if == "$phys" ]] || G_WARNING="$net routes via ${cur_if:-nothing}, not $phys (a route tunlock did not create may be in the way)"
  done
  while read -r net rec _; do
    [[ -n $net && $keep != *" $net "* ]] || continue
    route_op delete "$net" "$rec" >/dev/null 2>&1 || true
    route_forget "$net"
    log "exception removed: $net"
  done < "$RUN_DIR/routes"
}

route_forget() {
  awk -v n="$1" '$1 != n' "$RUN_DIR/routes" > "$RUN_DIR/routes.tmp"
  mv -f "$RUN_DIR/routes.tmp" "$RUN_DIR/routes"
}

# Per-domain DNS via /etc/resolver. Files without our marker are not touched.
sync_resolvers() {
  local i dom f want
  mkdir -p "$RESOLVER_DIR"
  for (( i = 0; i < ${#DNS_DOMAINS[@]}; i++ )); do
    dom=${DNS_DOMAINS[i]}
    f=$RESOLVER_DIR/$dom
    want=$(printf '%s\nnameserver %s' "$RESOLVER_MARK" "${DNS_SERVERS[i]}")
    if [[ -e $f ]] && ! grep -qxF "$RESOLVER_MARK" "$f"; then
      G_WARNING="$f exists and is not managed by tunlock"
      continue
    fi
    if [[ $(cat "$f" 2>/dev/null) != "$want" ]]; then
      printf '%s\n' "$want" > "$f"
      chmod 644 "$f"
      log "dns: $dom -> ${DNS_SERVERS[i]}"
    fi
  done
  for f in "$RESOLVER_DIR"/*; do
    [[ -f $f ]] && grep -qxF "$RESOLVER_MARK" "$f" || continue
    dom=${f##*/}
    [[ " ${DNS_DOMAINS[*]-} " == *" $dom "* ]] && continue
    rm -f "$f"
    log "dns: $dom removed"
  done
}

cmd_cleanup() {
  require_root
  load_config
  BYPASS_LIST=() DNS_DOMAINS=() DNS_SERVERS=()
  mkdir -p "$RUN_DIR"
  sync_bypass_routes
  sync_resolvers
}

# ---------------------------------------------------------------- guard

read_mode() {
  local m
  m=$(cat "$STATE_DIR/mode" 2>/dev/null || true)
  [[ $m == protected ]] && echo protected || echo direct
}

write_state() {
  local tmp=$RUN_DIR/state.$$
  {
    echo "updated=$(date +%s)"
    echo "ack=$G_ACK_NEXT"
    echo "mode=$G_MODE"
    echo "phase=$G_PHASE"
    echo "tun=$G_TUN"
    echo "ssh=$G_SSH"
    echo "ssh_endpoint=$HEALTH_HOST:$HEALTH_PORT"
    echo "entry=$ENTRY_HOST:$ENTRY_PORT"
    echo "entry_up=$G_ENTRY"
    echo "cascade=$([[ -n $JUMP_HOST ]] && echo 1 || echo 0)"
    echo "upstream=$UPSTREAM"
    echo "egress_ip=$G_EGRESS_IP"
    echo "egress_ok=$G_EGRESS_OK"
    echo "egress_at=$G_EGRESS_AT"
    echo "egress_country=$G_EGRESS_COUNTRY"
    echo "egress_check=$G_EGRESS_CHECK"
    echo "phys=$G_PHYS"
    echo "expected=$EXPECTED_EGRESS"
    echo "expected_country=$EXPECTED_COUNTRY"
    echo "pf_enabled=$G_PF_ENABLED"
    echo "pf_rules=$G_PF_RULES"
    echo "pf_anchor=$PF_ANCHOR"
    echo "pf_reachable=$G_PF_REACHABLE"
    echo "error=$G_ERROR"
    echo "pf_conflict=$G_CONFLICT"
    echo "warning=$G_WARNING"
    echo "bypass=${BYPASS_LIST[*]-}"
    echo "ai_nets=$(ai_closing && echo "${AI4[*]-} ${AI6[*]-}" | xargs)"
    echo "ai_closed=$G_AI_CLOSED"
    echo "reason=$(guard_reason)"
  } > "$tmp"
  chmod 644 "$tmp"
  mv -f "$tmp" "$RUN_DIR/state"
}

# Why the internet is open, closed or unprotected right now, one code from
# the guard's own view. It follows the same order as compute_verdict, so the
# reason never contradicts the verdict. Readers replace it with "stale" when
# the state is old.
#   ok                    protected: the exit is verified
#   off / release_failed  direct mode, rules removed or not
#   pf_conflict pf_error pf_disabled pf_unreachable pf_no_rules
#                         unprotected: tunlock's rules are not (alone) in force
#   sleep no_tun exit_mismatch entry_down ssh_down exit_no_answer exit_pending
#                         blocked: nothing leaves, and this is the first cause
#   unknown               none of the above: no guess
guard_reason() {
  if [[ $G_MODE == direct ]]; then
    [[ -z $G_ERROR ]] && echo off || echo release_failed
  elif [[ -n $G_CONFLICT ]]; then echo pf_conflict
  elif [[ -n $G_ERROR ]]; then echo pf_error
  elif [[ $G_PF_ENABLED != 1 ]]; then echo pf_disabled
  elif [[ $G_PF_REACHABLE != 1 ]]; then echo pf_unreachable
  elif (( ${G_PF_RULES:-0} <= 0 )); then echo pf_no_rules
  elif [[ $G_PHASE == open ]]; then echo ok
  elif [[ $G_PHASE != block && $G_PHASE != probe ]]; then echo unknown
  elif [[ ${G_SLEEPING:-0} == 1 ]]; then echo sleep
  elif [[ -z $G_TUN ]]; then echo no_tun
  # An exit seen answering from another address is a fact; a failed probe
  # of the entry may be a one-off. The probe stays visible as entry_up.
  elif [[ $G_EGRESS_CHECK == mismatch ]]; then echo exit_mismatch
  elif [[ ($UPSTREAM == proxy || -n $JUMP_HOST) && $G_ENTRY == down ]]; then echo entry_down
  elif [[ $UPSTREAM != proxy && $G_SSH == down ]]; then echo ssh_down
  else
    case $G_EGRESS_CHECK in
      mismatch) echo exit_mismatch ;;
      no_answer) echo exit_no_answer ;;
      *) echo exit_pending ;;
    esac
  fi
}

guard_sync_rules() {
  local want rules
  if [[ -z $G_TUN ]]; then want=block
  # Never open while connections from before protection may still be alive.
  elif [[ $G_EGRESS_OK == 1 && $G_ARMED == 1 ]]; then want=open
  else want=probe
  fi
  rules=$(render_rules "$want" "$G_TUN" "$G_PHYS")
  if [[ $rules == "$G_APPLIED" ]] && pf_has_label "$(rules_label "$rules")"; then
    G_PHASE=$want
    return 0
  fi
  if pf_apply "$rules"; then
    G_APPLIED=$rules
    G_PHASE=$want
    log "pf: phase $want${G_TUN:+ on $G_TUN}"
    return 0
  fi
  G_APPLIED=''
  log "pf: FAILED to apply phase $want: $G_ERROR"
  fail_closed
  return 1
}

# Direct mode with AI_NETS: the tunnel rules go, in one transaction, and
# only the AI networks stay closed. Connections to them opened before (or
# through the tunnel) are dropped. A failure here is a warning, not a failed
# switch: the rest of direct mode works, but the AI networks are NOT closed.
guard_direct_ai() {
  local rules net err=''
  G_AI_CLOSED=0
  rules=$(render_rules direct)
  if [[ $rules != "$G_APPLIED" ]] || ! pf_has_label "$(rules_label "$rules")"; then
    if ! pf_enabled || [[ ! -s $RUN_DIR/token ]]; then pf_enable_ref >/dev/null || err="pf could not be enabled"; fi
    [[ -n $err ]] || ensure_root_ruleset || err="root pf ruleset does not reach anchor $PF_ANCHOR"
    if [[ -z $err ]] && pf_apply "$rules"; then
      G_APPLIED=$rules
      for net in ${AI4[@]+"${AI4[@]}"}; do pfctl -k 0.0.0.0/0 -k "$net" >/dev/null 2>&1 || true; done
      for net in ${AI6[@]+"${AI6[@]}"}; do pfctl -k ::/0 -k "$net" >/dev/null 2>&1 || true; done
      log "direct mode: only the AI networks stay closed: $AI_NETS"
    else
      err=${err:-$G_ERROR}
      G_ERROR='' G_APPLIED=''
      [[ $G_AI_WARNED == "$err" ]] || log "direct mode: AI networks NOT closed: $err"
      G_AI_WARNED=$err
      G_WARNING="AI networks NOT closed outside the tunnel: $err"
      return
    fi
  fi
  if ! pf_enabled; then err="pf is disabled"
  elif ! pf_anchor_reachable; then err="root pf ruleset does not reach anchor $PF_ANCHOR"
  elif [[ -n $(pf_conflicts | head -1) ]]; then err="other pf rules decide before tunlock (tunlock conflicts)"
  fi
  if [[ -n $err ]]; then
    G_WARNING="AI networks NOT closed outside the tunnel: $err"
    G_APPLIED=''  # load again next tick
    return
  fi
  G_AI_CLOSED=1 G_AI_WARNED=''
}

# The wanted set was rejected, and the anchor may still hold an older, more
# permissive one. Fall back step by step; the next tick retries the wanted set.
fail_closed() {
  local err=$G_ERROR
  if pf_apply "$(render_emergency)"; then
    G_PHASE=emergency
    G_ERROR="$err; emergency block loaded"
    log "pf: emergency block loaded"
    return 0
  fi
  # pf refuses every load. Any utun the loaded rules still let traffic into is
  # no longer trusted: take each one down and confirm it. The old set's final
  # block still stops direct traffic. The interfaces come from the live rules,
  # not from G_TUN, which may already point at a newer utun.
  local ifc downed='' stuck=''
  for ifc in $(pfctl -a "$PF_ANCHOR" -sr 2>/dev/null \
      | grep -oE "on utun[0-9]+ inet( proto tcp)? from $TUN_ADDR to" | awk '{ print $2 }' | sort -u); do
    ifconfig "$ifc" down >/dev/null 2>&1 || true
    if [[ $(iface_state "$ifc") == down ]]; then downed="$downed $ifc"; else stuck="$stuck $ifc"; fi
  done
  G_ERROR="$err; pf refuses all loads"
  [[ -z $downed ]] || { G_ERROR="$G_ERROR; taken down:$downed"; log "pf refuses all loads: taken down:$downed"; }
  [[ -z $stuck ]] || { G_ERROR="$G_ERROR; could NOT confirm taken down:$stuck"; log "pf refuses all loads: could NOT confirm taken down:$stuck"; }
  G_PHASE=failed  # nothing confirmed: never report a phase pf did not take
}

# up, down or unknown (when ifconfig cannot read the interface).
iface_state() {
  local first
  first=$(ifconfig "$1" 2>/dev/null | head -1) || true
  [[ $first == "$1:"*flags=* ]] || { echo unknown; return; }
  if grep -q '<UP[,>]' <<< "$first"; then echo up; else echo down; fi
}

# Smallest set that still lets SSH reconnect and the Mac keep its address.
render_emergency() {
  local body
  body=$(printf '%s\n' "pass quick on lo0 all no state" \
    "pass out quick inet proto tcp to $ENTRY_HOST port $ENTRY_PORT flags any keep state (if-bound)" \
    "pass out quick inet proto udp from any port 68 to any port 67 no state" \
    "pass in quick inet proto udp from any port 67 to any port 68 no state")
  echo "# tunlock $VERSION emergency"
  echo "$body"
  echo "block drop quick all label \"tunlock-emergency\""
}

# Is the verified egress still trustworthy? Anything that breaks the path
# sends the tunnel back to probe until a fresh answer comes back.
egress_still_valid() {
  local now=$1
  [[ $G_EGRESS_OK == 1 ]] || return 0
  if [[ $G_SSH == down ]]; then
    log "ssh forward down: egress unverified, tunnel closed until verified"
  elif (( now - G_EGRESS_AT > PROBE_INTERVAL * 2 + 10 )); then
    log "egress check expired: tunnel closed until verified"
  else
    return 0
  fi
  G_EGRESS_OK=0 G_EGRESS_CHECK=pending
}

guard_tick() {
  local now ip tun req
  now=$(date +%s)
  # Read the CLI's request id before the mode: the CLI writes the mode first,
  # so an id seen here always comes with its mode. Echoed as ack in the state.
  req=$(cat "$STATE_DIR/request" 2>/dev/null || true)
  # A long gap between ticks means the Mac slept. The TUN client may have
  # reconnected elsewhere under the same utun, so verify egress again.
  if (( G_LAST_TICK > 0 && now - G_LAST_TICK > 10 )) && [[ $G_EGRESS_OK == 1 ]]; then
    log "woke after $((now - G_LAST_TICK))s: re-verifying egress"
    G_EGRESS_OK=0 G_EGRESS_CHECK=pending
  fi
  G_LAST_TICK=$now
  G_MODE=$(read_mode)
  G_ACK_NEXT=$req
  G_PROBED=0
  checks_take
  G_ERROR=''
  G_WARNING=''
  G_PHYS=$(physical_iface)
  # Exceptions hold in both modes, so the LAN works the same either way.
  sync_bypass_routes
  sync_resolvers
  if [[ $UPSTREAM == proxy ]]; then G_SSH=none
  elif ssh_up; then G_SSH=up
  else G_SSH=down
  fi
  if (( now - G_ENTRY_AT >= 15 )); then
    G_ENTRY_AT=$now
    if entry_up; then G_ENTRY=up; else G_ENTRY=down; fi
  fi

  if [[ $G_MODE == direct ]]; then
    if ai_closing; then
      guard_direct_ai
    elif [[ -n $G_APPLIED || -e $RUN_DIR/token ]] || pf_rules_live; then
      if pf_release; then
        log "direct mode: rules removed, pf reference released"
      else
        log "direct mode: FAILED to remove rules: $G_ERROR"
      fi
      G_APPLIED=''
    fi
    rm -f "$RUN_DIR/armed"
    G_PHASE=direct G_TUN='' G_EGRESS_OK=0 G_EGRESS_CHECK=pending G_ARMED=0
    G_PF_RULES=0 G_PF_REACHABLE=- G_CONFLICT='' G_SVC_LEFT=3
    if pf_enabled; then G_PF_ENABLED=1; else G_PF_ENABLED=0; fi
    return
  fi

  if ! ensure_root_ruleset; then
    G_ERROR="root pf ruleset does not reach anchor $PF_ANCHOR"
  fi

  local tm
  tm=$(find_tun_mask || true)
  tun=${tm%% *}
  if [[ -n $tun && -z $TUN_MASK ]]; then TUN_NET=$(tun_net "${tm#* }"); fi
  if [[ $tun != "$G_TUN" ]]; then
    [[ -n $tun ]] && log "tun: ${G_TUN:-none} -> $tun" || log "tun: $G_TUN gone"
    G_TUN=$tun
    G_EGRESS_OK=0 G_EGRESS_CHECK=pending  # a new interface has to prove its egress again
  fi
  egress_still_valid "$now"
  # The Mac is about to sleep (tunlock-sleepwatch asks): close the tunnel now,
  # and keep it closed until a fresh exit check after wake.
  local sleeping=0
  G_SLEEPING=0
  if [[ -e $RUN_DIR/sleep-request ]]; then
    sleeping=1 G_SLEEPING=1
    if [[ $G_EGRESS_OK == 1 ]]; then log "Mac going to sleep: tunnel closed until the exit is verified after wake"; fi
    G_EGRESS_OK=0 G_EGRESS_CHECK=pending
  fi
  local rules_ok=1
  guard_sync_rules || rules_ok=0
  # The AI block is part of every phase's rules.
  G_AI_CLOSED=0
  if ai_closing && (( rules_ok )); then G_AI_CLOSED=1; fi

  if ! pf_enabled || [[ ! -s $RUN_DIR/token ]]; then
    if pf_enable_ref; then
      log "pf enabled (token $(cat "$RUN_DIR/token" 2>/dev/null || echo none))"
    else
      G_ERROR=${G_ERROR:-"pf could not be enabled"}
    fi
  fi
  # Connections opened before protection keep their pf state; drop them once,
  # after our rules are confirmed in place.
  if [[ $G_ARMED == 0 && $rules_ok == 1 ]]; then
    if pfctl -F states >/dev/null 2>&1; then
      policy_fingerprint > "$RUN_DIR/armed"
      G_ARMED=1
      log "protected mode armed, existing connections reset"
    else
      G_ERROR=${G_ERROR:-"could not reset existing connections"}
    fi
  fi
  [[ $G_ARMED == 1 ]] || G_ERROR=${G_ERROR:-"existing connections not reset yet"}
  # Tell the sleep helper the tunnel is closed, so the Mac may sleep.
  if (( sleeping )) && [[ $rules_ok == 1 && ! -e $RUN_DIR/sleep-ack ]]; then touch "$RUN_DIR/sleep-ack"; fi

  # A TUN client that gave up (its port was dead while the entry blinked) is
  # started again once the forward is back: nothing else brings the tunnel
  # up. Only behind confirmed rules, a few tries per time the forward comes
  # back, and never again once a tunnel was up: a client the user stopped
  # on purpose stays stopped.
  local fwd=0
  if [[ $UPSTREAM == proxy ]]; then [[ $G_ENTRY == up ]] && fwd=1
  else [[ $G_SSH == up ]] && fwd=1
  fi
  if (( ! fwd )); then G_SVC_LEFT=3 G_SVC_HELD=''
  elif [[ -n $tun ]]; then G_SVC_LEFT=0
  elif [[ -n $TUN_SERVICE && $sleeping == 0 && $rules_ok == 1 && $G_ARMED == 1 && -z $G_ERROR ]] \
    && (( G_SVC_LEFT > 0 && now - G_SVC_AT >= 60 * (3 - G_SVC_LEFT) )) \
    && [[ $G_SVC_HELD != svc || -z $G_SVC_WARN ]]; then  # a missing service waits for the minute check
    # The same checks as the verdict, right now: pf on, the anchor reached,
    # nothing deciding before it, and protection still asked for. Checked
    # every tick, logged once: the start follows as soon as they pass.
    if ! pf_enabled || ! pf_anchor_reachable || [[ -n $(pf_conflicts | head -1) ]] || ! pf_rules_live \
      || [[ $(read_mode) != protected ]]; then
      [[ $G_SVC_HELD == pf ]] || log "not starting the TUN app: pf protection is not confirmed"
      G_SVC_HELD=pf
    else
      G_SVC_AT=$now
      resolve_tun_service
      if [[ -n $SVC_WARN ]]; then
        [[ $G_SVC_HELD == svc ]] || log "not starting the TUN app: $SVC_WARN"
        G_SVC_HELD=svc
      else
        G_SVC_HELD='' G_SVC_LEFT=$((G_SVC_LEFT - 1))
        log "the forward is up but no tunnel is: starting $SVC_NAME"
        as_console_user scutil --nc start "$SVC_REF" >/dev/null 2>&1 || true
        (( G_SVC_LEFT > 0 )) || log "$SVC_NAME did not bring a tunnel up; start it yourself"
      fi
    fi
  fi
  # A configured TUN app that no longer exists is shown, checked once a minute.
  if [[ -n $TUN_SERVICE ]] && (( now - G_SVC_CHECK_AT >= 60 )); then
    G_SVC_CHECK_AT=$now
    resolve_tun_service
    G_SVC_WARN=$SVC_WARN
  fi
  [[ -n $G_WARNING || -z $G_SVC_WARN ]] || G_WARNING=$G_SVC_WARN

  if [[ -n $G_TUN && $rules_ok == 1 && $G_ARMED == 1 && $sleeping == 0 ]]; then
    local interval=$PROBE_INTERVAL
    [[ $G_EGRESS_OK == 1 ]] || interval=3
    # A pending tunlock run gets a probe of its own, made after its request.
    if (( now - G_PROBE_AT >= interval )) || [[ -n $G_CHECKS ]]; then
      G_PROBE_AT=$now G_PROBED=1
      local loc=''
      read -r ip loc <<< "$(probe_egress || true)"
      [[ $loc =~ ^[A-Z]{2}$ ]] || loc=''
      [[ -z $ip ]] || G_EGRESS_COUNTRY=$loc
      if egress_matches "$ip" "$loc"; then
        [[ $G_EGRESS_OK == 1 && $ip == "$G_EGRESS_IP" ]] || log "egress verified: $ip${loc:+ ($loc)} via $G_TUN"
        G_EGRESS_OK=1 G_EGRESS_IP=$ip G_EGRESS_AT=$now G_EGRESS_CHECK=ok
      elif [[ -n $ip ]]; then
        log "egress MISMATCH: got $ip${loc:+ ($loc)}, expected $(expected_desc); tunnel closed"
        G_EGRESS_OK=0 G_EGRESS_IP=$ip G_EGRESS_AT=$now G_EGRESS_CHECK=mismatch
      else
        if [[ $G_EGRESS_OK == 1 ]]; then log "egress check got no answer: tunnel closed until verified"; fi
        G_EGRESS_OK=0 G_EGRESS_CHECK=no_answer
      fi
      guard_sync_rules || true
    fi
  fi

  if pf_enabled; then G_PF_ENABLED=1; else G_PF_ENABLED=0; fi
  G_PF_RULES=$(pf_rule_count)
  if pf_anchor_reachable; then G_PF_REACHABLE=1; else G_PF_REACHABLE=0; fi
  G_CONFLICT=$(pf_conflicts | awk 'NR <= 3' | paste -sd ';' -)  # not head: see physical_iface
  pf_rules_live || G_ERROR=${G_ERROR:-"anchor rules missing"}
}

# Everything that may leave outside the tunnel. A change means old pf states
# may now allow traffic the new policy forbids.
policy_fingerprint() {
  # UPSTREAM too: a proxy entry passes TCP and UDP, an SSH entry only TCP.
  echo "upstream=$UPSTREAM entry=$ENTRY_HOST:$ENTRY_PORT bypass=${BYPASS_LIST[*]-} dns=${DNS_SERVERS[*]-} anchor=$PF_ANCHOR"
}

guard_init() {
  mkdir -p "$STATE_DIR" "$RUN_DIR"
  chmod 755 "$STATE_DIR" "$RUN_DIR"
  G_MODE='' G_PHASE='' G_TUN='' G_SSH='' G_EGRESS_IP='' G_EGRESS_OK=0 G_EGRESS_AT=0 G_EGRESS_CHECK=pending
  G_PF_ENABLED=0 G_PF_RULES=0 G_PF_REACHABLE=- G_ERROR='' G_APPLIED='' G_PROBE_AT=0 G_LAST_TICK=0
  G_ENTRY=unknown G_ENTRY_AT=0 G_SLEEPING=0 G_WARNING='' G_PHYS='' G_EGRESS_COUNTRY='' G_ACK_NEXT='' G_CONFLICT=''
  G_SVC_AT=0 G_SVC_LEFT=3 G_SVC_CHECK_AT=0 G_SVC_WARN='' G_SVC_HELD='' G_AI_CLOSED=0 G_AI_WARNED=''
  checks_init
  # A restarted guard must not reset connections again within one boot.
  G_ARMED=0
  # ...unless what may pass outside the tunnel changed (another proxy or
  # server, an exception removed): connections opened under the old policy
  # keep their pf state, so they must be reset once more.
  if [[ -e $RUN_DIR/armed && $(cat "$RUN_DIR/armed") == "$(policy_fingerprint)" ]] && pf_rules_live; then
    G_ARMED=1
  fi
}

# ---- fresh exit checks for tunlock run
# Users ask by creating an empty file named by a random id in CHECK_DIR
# (root's, sticky, writable by all, like /tmp). The kernel records who
# created it; the guard probes the exit in the same tick and writes the
# answer to ANSWER_DIR, which only root can write. The channel can only ask
# for a probe: it changes no mode, rule or setting.
CHECK_DIR=$RUN_DIR/check
ANSWER_DIR=$RUN_DIR/answer
CHECK_ID_RE='^[0-9a-f]{32}$'

checks_init() {
  checks_dirs
  G_CHECKS='' G_CONF_HASH=$(conf_hash)
}

# Recreated when missing; a failure only means tunlock run gets no answer.
checks_dirs() {
  { mkdir -p "$CHECK_DIR" "$ANSWER_DIR" && chmod 1733 "$CHECK_DIR" && chmod 755 "$ANSWER_DIR"; } 2>/dev/null \
    || log "cannot prepare the tunlock run check directories"
}

conf_hash() { shasum -a 256 < "$CONF" 2>/dev/null | awk '{ print $1 }'; }

# Requests are read by a scanner in the background, never by the tick: the
# directory is writable by everyone, and listing a huge one would hold up
# pf work. The tick takes what a finished scan found (requests that existed
# before this tick, so the probe below is made after them) and starts the
# next scan. A scan looks at most CHECK_PER_TICK entries: plain files with a
# valid id, from root or a regular user; it removes what it looked at.
CHECK_PER_TICK=16
checks_take() {
  local take=$RUN_DIR/check.take mark=$RUN_DIR/check.scan pid
  G_CHECKS=''
  [[ -d $CHECK_DIR && -d $ANSWER_DIR ]] || checks_dirs
  if [[ -f $take ]]; then
    G_CHECKS=$(tr '\n' ' ' < "$take" 2>/dev/null || true)
    rm -f "$take" 2>/dev/null || true
  fi
  pid=$(cat "$mark" 2>/dev/null || true)
  if [[ $pid =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then return 0; fi
  checks_scan &
  echo $! > "$mark" 2>/dev/null || true
}

checks_scan() {
  local f id uid n=0 out=''
  while IFS= read -r -d '' f; do
    (( n++ < CHECK_PER_TICK )) || break
    id=${f##*/}
    if [[ $id =~ $CHECK_ID_RE && -f $f && ! -L $f ]]; then
      uid=$(stat -f %u "$f" 2>/dev/null || true)
      if [[ $uid =~ ^[0-9]+$ ]] && (( uid == 0 || uid >= 500 )); then out+="$id:$uid"$'\n'; fi
    fi
    # Never recursive: a tree someone built in here is not ours to walk.
    if [[ -d $f && ! -L $f ]]; then rmdir "$f" 2>/dev/null || true; else rm -f "$f" 2>/dev/null || true; fi
  done < <(find "$CHECK_DIR" -mindepth 1 -maxdepth 1 -print0 2>/dev/null)
  if [[ -n $out ]]; then
    printf '%s' "$out" > "$RUN_DIR/check.take.tmp" 2>/dev/null && mv -f "$RUN_DIR/check.take.tmp" "$RUN_DIR/check.take" 2>/dev/null
  fi
  rm -f "$RUN_DIR/check.scan" 2>/dev/null || true
}

# After the tick: one answer per request, from this tick's own state.
checks_answer() {
  local c id uid tmp
  find "$ANSWER_DIR" -type f -mmin +2 -delete 2>/dev/null || true
  for c in $G_CHECKS; do
    id=${c%%:*} uid=${c#*:}
    tmp=$ANSWER_DIR/.$id
    # Never the end of the guard: a lost answer only times out that run.
    # The answer is written in one step whose failure is checked, and only
    # a regular file ever becomes the answer.
    local body
    body=$(printf '%s\n' "id=$id" "uid=$uid" "at=$(date +%s)" "probed=$G_PROBED" "mode=$G_MODE" \
      "egress_ok=$G_EGRESS_OK" "egress_ip=$G_EGRESS_IP" "egress_country=$G_EGRESS_COUNTRY" \
      "reason=$(guard_reason)" "config=$G_CONF_HASH")
    if ( printf '%s\n' "$body" > "$tmp" ) 2>/dev/null && [[ -f $tmp && ! -L $tmp ]] \
      && chmod 644 "$tmp" 2>/dev/null && mv -f "$tmp" "$ANSWER_DIR/$id" 2>/dev/null; then
      :
    else
      [[ ! -f $tmp ]] || rm -f "$tmp" 2>/dev/null || true
      log "could not answer a tunlock run check"
    fi
  done
  G_CHECKS=''
}

# Starts tunlock-sleepwatch next to the guard when it is installed.
start_sleepwatch() {
  local helper
  helper="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/tunlock-sleepwatch"
  [[ -x $helper ]] || return 0
  if [[ -s $RUN_DIR/sleepwatch.pid ]]; then kill "$(cat "$RUN_DIR/sleepwatch.pid")" 2>/dev/null || true; fi
  "$helper" "$RUN_DIR" &
  echo $! > "$RUN_DIR/sleepwatch.pid"
}

cmd_guard() {
  require_root
  load_config
  guard_init
  start_sleepwatch
  # Stopping the guard leaves the rules in place on purpose: fail closed.
  trap 'log "guard stopped"; [[ -s $RUN_DIR/sleepwatch.pid ]] && kill "$(cat "$RUN_DIR/sleepwatch.pid")" 2>/dev/null; exit 0' TERM INT
  log "guard $VERSION started, mode $(read_mode)"
  while :; do
    guard_tick
    write_state
    checks_answer
    sleep "$TICK" &
    wait $! || true
  done
}

# ---------------------------------------------------------------- ssh

# Fills SSH_ARGS with the full ssh command line for the current network.
build_ssh_args() {
  local iface=$1 identity=${SSH_IDENTITY/#\~/$HOME}
  # ConnectTimeout also bounds the banner exchange, so a relay that answers
  # slowly still gets a chance. The alive counters ride out a short entry
  # blink instead of tearing the tunnel down: the guard verifies the exit on
  # its own and closes the rules when the tunnel really is gone.
  local common="-o BatchMode=yes -o StrictHostKeyChecking=yes -o ConnectTimeout=15 -o ServerAliveInterval=10 -o ServerAliveCountMax=6"
  SSH_ARGS=(ssh -NT -p "$SSH_PORT" -o ExitOnForwardFailure=yes -o ControlMaster=no -o ControlPath=none)
  # shellcheck disable=SC2206
  SSH_ARGS+=($common)
  [[ -z $identity ]] || SSH_ARGS+=(-i "$identity")
  if [[ -n $JUMP_HOST ]]; then
    # Only the outer hop touches the physical network, so it gets -B.
    SSH_ARGS+=(-o "ProxyCommand=/usr/bin/ssh -B $iface -p $JUMP_PORT $common${identity:+ -i $identity} -W %h:%p $JUMP_USER@$JUMP_HOST")
  else
    SSH_ARGS+=(-B "$iface")
  fi
  SSH_ARGS+=("${FORWARD_ARGS[@]}" "$SSH_USER@$SSH_HOST")
}

cmd_ssh_run() {
  [[ $EUID != 0 ]] || die "ssh-run must run as your user, so ssh uses your key"
  load_config
  local iface
  # Proxy upstream: the TUN client reaches the proxy itself, no SSH at all.
  # Stay idle (not exit) so launchd does not respawn this job in a loop.
  if [[ $UPSTREAM == proxy ]]; then
    log "UPSTREAM=proxy: no SSH forward needed"
    while :; do sleep 3600; done
  fi
  # While tunlock is off, hold no port: other tools may use it. "off"
  # restarts this job, so a running ssh stops and lands here.
  if [[ $(read_mode) != protected ]]; then
    log "tunlock is off: SSH forward idle"
    while [[ $(read_mode) != protected ]]; do sleep 2; done
    log "tunlock is on: starting SSH forward"
  fi
  local identity=${SSH_IDENTITY/#\~/$HOME}
  # A blinking entry (a busy relay, a flaky uplink) must not become a retry
  # storm: every attempt is a new connection the entry may rate limit, and
  # launchd would respawn this job within seconds of each failure. Back off
  # between attempts, and stop as soon as protection is switched off.
  local attempt=0 delay rc
  while :; do
    # Every attempt takes the physical route as it is now (Wi-Fi may have
    # become Ethernet), never the tunnel it feeds.
    iface=$(physical_iface)
    rc=0
    if [[ -z $iface ]]; then
      log "no physical IPv4 default route"
      rc=1
    else
      # The macOS agent starts empty after login; load the key from Keychain.
      if [[ -n $identity ]] && ! ssh-add -l >/dev/null 2>&1; then
        ssh-add --apple-use-keychain "$identity" </dev/null >/dev/null 2>&1 || true
      fi
      build_ssh_args "$iface"
      log "ssh to $SSH_HOST:$SSH_PORT${JUMP_HOST:+ through $JUMP_HOST:$JUMP_PORT} via $iface"
      "${SSH_ARGS[@]}" || rc=$?  # under set -e a bare failure would end the loop
    fi
    [[ $(read_mode) == protected ]] || { log "tunlock is off: SSH forward idle"; return 0; }
    if (( rc == 0 )); then attempt=0; else attempt=$((attempt + 1)); fi
    delay=$((5 + attempt * 5)); (( delay > 60 )) && delay=60
    log "ssh exited ($rc); next attempt in ${delay}s"
    sleep "$delay" &
    wait $! || true
  done
}

# ---------------------------------------------------------------- cli

require_root() { [[ $EUID == 0 || -n ${TUNLOCK_TEST_PATH:-} ]] || die "run with sudo"; }

# Test-only commands must never touch the real system: refuse root outright
# (stubs are disabled for root) and insist on the stub path.
test_only() {
  [[ $EUID != 0 ]] || die "test-only command refused as root"
  [[ -n ${TUNLOCK_TEST_PATH:-} ]] || die "test only"
}

# With the optional sudoers entry, mode switches need no password.
elevate() {
  [[ $EUID == 0 || -n ${TUNLOCK_TEST_PATH:-} ]] && return 0
  exec sudo "$(readlink -f "${BASH_SOURCE[0]}")" "$@"
}

state_get() { awk -F= -v k="$1" '$1 == k { sub(/^[^=]*=/, ""); print; exit }' "$RUN_DIR/state" 2>/dev/null; }

guard_running() {
  [[ -z ${TUNLOCK_TEST_PATH:-} ]] || return "${TUNLOCK_TEST_NO_GUARD:-0}"
  launchctl print "system/$GUARD_LABEL" >/dev/null 2>&1
}

# One verdict from the guard's state file, the same rules the app uses:
#   protected    pf holds our rules and the tunnel exit is verified
#   blocked      pf holds our rules, no verified tunnel: nothing leaves
#   direct       direct mode, no kill switch
#   unprotected  protected mode, but pf state is not confirmed (or an error)
#   unknown      no fresh state: the guard is not running
compute_verdict() {
  [[ -r $RUN_DIR/state ]] || { echo unknown; return; }
  local updated mode phase pfe pfr reach err conflict
  updated=$(state_get updated); mode=$(state_get mode); phase=$(state_get phase)
  pfe=$(state_get pf_enabled); pfr=$(state_get pf_rules); reach=$(state_get pf_reachable)
  err=$(state_get error); conflict=$(state_get pf_conflict)
  if (( $(date +%s) - ${updated:-0} > 10 )); then echo unknown
  elif [[ $mode == direct ]]; then
    [[ -z $err ]] && echo direct || echo error
  elif [[ $pfe == 1 && $reach == 1 && ${pfr:-0} -gt 0 && -z $err && -z $conflict ]]; then
    case $phase in
      open) echo protected ;;
      block | probe) echo blocked ;;
      *) echo unprotected ;;
    esac
  else echo unprotected
  fi
}

# Asks the guard for a mode and waits for its answer to this very request:
# a fresh id is written after the mode, and only a state that echoes it
# counts. A snapshot written before the command, however fresh, never does.
request_mode() { # mode limit
  local id i
  id=$(date +%s)-$$-$RANDOM
  mkdir -p "$STATE_DIR"
  (umask 022; echo "$1" > "$STATE_DIR/mode"; echo "$id" > "$STATE_DIR/request.tmp")
  mv -f "$STATE_DIR/request.tmp" "$STATE_DIR/request"
  for (( i = 0; i < $2; i++ )); do
    [[ $(state_get ack) == "$id" ]] && return 0
    sleep 1
  done
  return 1
}

wait_limit() { [[ -n ${TUNLOCK_TEST_PATH:-} ]] && echo "${TUNLOCK_TEST_WAIT:-3}" || echo "$1"; }

# Exit 0 only when the guard answered this request with a confirmed
# protected or blocked state.
cmd_protect() {
  elevate protect "$@"
  load_config
  local v i limit
  limit=$(wait_limit 25)
  guard_running || die "the guard is not running: run install.sh"
  echo "Protected mode on. Waiting for the guard to confirm..."
  if ! request_mode protected "$limit"; then
    cmd_status || true
    echo "tunlock: the guard did not answer this request; protection NOT confirmed" >&2
    return 1
  fi
  for (( i = 0; i < limit; i++ )); do
    [[ $(compute_verdict) == protected ]] && break
    sleep 1
  done
  v=$(compute_verdict)
  # Rules confirmed first, so the TUN client can only come up behind them.
  if [[ ( $v == protected || $v == blocked ) && -n $TUN_SERVICE ]]; then
    resolve_tun_service
    if [[ -n $SVC_WARN ]]; then
      echo "tunlock: $SVC_WARN" >&2
    else
      # Only the guard starts the TUN client: once the forward (or the proxy
      # port) answers, with pf and the mode checked in that same tick, so an
      # off that comes in meanwhile can never be followed by a start.
      echo "The guard starts $SVC_NAME once the $([[ $UPSTREAM == proxy ]] && echo "proxy port answers" || echo "SSH forward is up"). Waiting for a verified tunnel..."
    fi
    for (( i = 0; i < limit + 10; i++ )); do
      [[ $(compute_verdict) == protected ]] && break
      sleep 1
    done
    v=$(compute_verdict)
  fi
  cmd_status || true
  case $v in
    protected) return 0 ;;
    blocked) echo "Kill switch confirmed; the tunnel is not verified yet, so nothing leaves." ; return 0 ;;
    *) echo "tunlock: protection NOT confirmed ($v)" >&2; return 1 ;;
  esac
}

# Running AI clients, one name per line. A client started under protection
# keeps its session: after off its next request leaves with the direct IP.
# Exit 1 when the process list cannot be read: "none found" must mean none.
ai_clients() {
  local comms args
  comms=$(ps -axo comm= 2>/dev/null) && [[ -n $comms ]] || { echo "tunlock: cannot list processes" >&2; return 1; }
  args=$(ps -axo args= 2>/dev/null) || { echo "tunlock: cannot list processes" >&2; return 1; }
  {
    awk '{ sub(/.*\//, ""); print }' <<< "$comms"
    # Claude Code installed with npm runs as node.
    [[ $args != */claude-code/cli* ]] || echo claude
  } | awk -v names="$AI_APPS" '
    BEGIN { n = split(names, a, " "); for (i = 1; i <= n; i++) want[a[i]] = 1 }
    ($0 in want) && !seen[$0]++' | sort
}

# Off in a terminal asks first while AI clients run, or when it cannot tell;
# --force skips it. Runs after elevate, so plain and sudo off ask the same,
# and once. The app asks on its own, then runs plain off (no tty there).
confirm_off() {
  local clients answer
  [[ ${1:-} != --force && -t 0 ]] || return 0
  if clients=$(ai_clients); then
    [[ -n $clients ]] || return 0
    echo "Still running: $(paste -sd, - <<< "$clients" | sed 's/,/, /g')."
    if ( load_config >/dev/null; ai_closing ) 2>/dev/null; then
      echo "Claude stays closed while off (AI_NETS): its requests fail instead of leaving directly."
      echo "Any other client's next request leaves with your direct IP. Close them first."
    else
      echo "Once off, their next request leaves with your direct IP. Close them first (/exit in Claude Code)."
    fi
  else
    echo "Could not check for running AI clients (Claude Code, Codex, ChatGPT)."
    echo "If any is open, its next request leaves with your direct IP once off."
  fi
  read -r -p "Turn off anyway? [y/N] " answer || answer=
  [[ $answer == [yY]* ]] || { echo "Left on."; return 1; }
}

# The app asks before off, then a password prompt may wait for minutes. It
# leaves what the user confirmed in this file: process names, or "?" for a
# check that failed. Off reads it as root and checks again just before the
# rules go: a client started since the question keeps protection on.
OFF_ACK_NAME='Library/Application Support/Tunlock/off-ack'
off_ack_path() {
  if [[ -n ${TUNLOCK_TEST_PATH:-} ]]; then echo "${TUNLOCK_OFF_ACK:-/nonexistent}"; return; fi
  local home
  home=$(dscl . -read "/Users/$(id -un "$(console_uid)")" NFSHomeDirectory 2>/dev/null | awk '{ print $2 }')
  [[ -n $home ]] && echo "$home/$OFF_ACK_NAME"
}

# No file: not the app, nothing to compare. The file is used up either way.
check_off_ack() {
  local ack acked clients name new=()
  ack=$(off_ack_path) || return 0
  [[ -n $ack && -f $ack && ! -L $ack ]] || return 0
  acked=$(head -c 4096 "$ack" 2>/dev/null || true)
  rm -f "$ack"
  if ! clients=$(ai_clients); then
    grep -qx '?' <<< "$acked" && return 0
    echo "tunlock: could not check AI clients again before off; left on" >&2
    return 1
  fi
  while IFS= read -r name; do
    [[ -z $name ]] || grep -qxF -- "$name" <<< "$acked" || new+=("$name")
  done <<< "$clients"
  (( ${#new[@]} == 0 )) && return 0
  echo "tunlock: AI clients started after the confirmation: ${new[*]}; left on" >&2
  return 1
}

# Exit 0 only when the guard answered this request with direct mode.
cmd_direct() {
  elevate direct "$@"
  confirm_off "$@" || return 1
  load_config
  check_off_ack || return 1
  local limit
  limit=$(wait_limit 10)
  if ! guard_running; then
    (umask 022; mkdir -p "$STATE_DIR"; echo direct > "$STATE_DIR/mode")
    if pf_release; then
      stop_keeper_and_service
      echo "Guard not running; rules removed directly."
      return 0
    fi
    echo "tunlock: guard not running and pf did not remove the rules; direct mode NOT confirmed" >&2
    return 1
  fi
  if ! request_mode direct "$limit"; then
    cmd_status || true
    echo "tunlock: the guard did not answer this request; direct mode NOT confirmed" >&2
    return 1
  fi
  [[ $(compute_verdict) == direct ]] || { cmd_status || true; echo "tunlock: direct mode NOT confirmed" >&2; return 1; }
  # Off means off: free the SSH port and stop the TUN client.
  stop_keeper_and_service
  cmd_status || true
}

# The logged-in user owns the SSH keeper and the TUN client.
console_uid() { echo "${SUDO_UID:-$(stat -f %u /dev/console)}"; }
# The VPN service to control, as SVC_REF (UUID, or the configured name when
# nothing better is known) and SVC_NAME (for messages). A TUN client update
# may register its VPN again as "<name> (<variant>)", e.g. "Karing (system)",
# and leave the old service with a provider that is gone: starting it only
# times out while protection sits in "block". Such a rename is taken only
# when it is the single one, from the same app as the configured service
# (when that still exists), and the configured one cannot start.
provider_live() { # UUID of a VPN service
  local bundle
  bundle=$(scutil --nc show "$1" 2>/dev/null | awk -F' : ' '/NEProviderBundleIdentifier/ { print $2; exit }')
  [[ -n $bundle ]] || return 1
  # Whole field, not a substring: karingService must not match karingServiceSE.
  systemextensionsctl list 2>/dev/null |
    awk -v b="$bundle" '{ for (i = 1; i <= NF; i++) if ($i == b && $0 ~ /activated enabled/) found = 1 } END { exit !found }'
}

resolve_tun_service() {
  SVC_REF=$TUN_SERVICE SVC_NAME=$TUN_SERVICE SVC_WARN=''
  [[ -n $TUN_SERVICE ]] || return 0
  local list exact='' exact_app='' name uuid app
  local -a cand=() cand_name=() similar=()
  # "uuid<TAB>app<TAB>name" per VPN service: app is the "(bundle id)" field.
  # A failed listing is "nothing known", never the end of the guard.
  list=$({ scutil --nc list 2>/dev/null || true; } | awk -F'"' 'NF >= 2 { split($1, a, " "); if (a[3] != "" && a[4] == "VPN") print a[3] "\t" a[5] "\t" $2 }')
  [[ -n $list ]] || return 0
  while IFS=$'\t' read -r uuid app name; do
    [[ $name == "$TUN_SERVICE" ]] && exact=$uuid exact_app=$app
  done <<< "$list"
  while IFS=$'\t' read -r uuid app name; do
    [[ $name == "$TUN_SERVICE ("*")" ]] || continue
    similar+=("$name")
    [[ -n $exact && $app == "$exact_app" ]] || continue
    cand+=("$uuid") cand_name+=("$name")
  done <<< "$list"
  if [[ -z $exact ]]; then
    # Without the old service nothing confirms which app a lookalike is from.
    SVC_WARN="VPN service \"$TUN_SERVICE\" no longer exists${similar[0]:+ (found: ${similar[*]})}: choose the TUN app again in Settings"
    return 0
  fi
  SVC_REF=$exact
  provider_live "$exact" && return 0
  if (( ${#cand[@]} == 1 )) && provider_live "${cand[0]}"; then
    log "TUN_SERVICE \"$TUN_SERVICE\" cannot start; using \"${cand_name[0]}\" of the same app" >&2
    SVC_REF=${cand[0]} SVC_NAME=${cand_name[0]}
  elif (( ${#cand[@]} > 1 )); then
    SVC_WARN="VPN service \"$TUN_SERVICE\" cannot start and has several successors (${cand_name[*]}): choose one in Settings"
  fi
}

as_console_user() { local uid; uid=$(console_uid); sudo -u "#$uid" -- "$@"; }

stop_keeper_and_service() {
  local uid
  uid=$(console_uid)
  # Restarted, the keeper sees mode off and idles without holding the port.
  launchctl kickstart -k "gui/$uid/$SSH_LABEL" >/dev/null 2>&1 || true
  if [[ -n $TUN_SERVICE ]]; then resolve_tun_service; as_console_user scutil --nc stop "$SVC_REF" >/dev/null 2>&1 || true; fi
}

# The guard's reason, unless its state is too old to say anything.
compute_reason() {
  [[ -r $RUN_DIR/state ]] || { echo no_state; return; }
  local r u
  u=$(state_get updated)
  if (( $(date +%s) - ${u:-0} > 10 )); then echo stale; return; fi
  r=$(state_get reason)
  echo "${r:-unknown}"
}

# One line per reason: what happened, then what to do.
reason_text() {
  case $1 in
    ok) echo "exit verified" ;;
    off) echo "tunlock is off" ;;
    release_failed) echo "rules could not be removed; run: sudo tunlock off" ;;
    pf_conflict) echo "other pf rules decide before tunlock; see Conflict, then tunlock doctor" ;;
    pf_error) echo "pf problem (see Error); run: tunlock doctor" ;;
    pf_disabled) echo "pf is disabled; the guard retries, run: tunlock doctor" ;;
    pf_unreachable) echo "the root pf ruleset does not reach tunlock's anchor; run: tunlock doctor" ;;
    pf_no_rules) echo "tunlock's anchor holds no rules; run: tunlock doctor" ;;
    sleep) echo "the Mac is going to sleep; the exit is checked again after wake" ;;
    no_tun) echo "no TUN interface; turn on your TUN app in TUN mode" ;;
    entry_down) echo "the TCP port of the entry ($(state_get entry)) does not answer; check the proxy or server" ;;
    ssh_down) echo "SSH forward is down; waiting for it to reconnect (tunlock logs)" ;;
    exit_mismatch) echo "the exit answered from $(state_get egress_ip), not the expected one; pin it in the app only if you changed it" ;;
    exit_no_answer) echo "the exit check through the tunnel got no answer; check the TUN app's connection" ;;
    exit_pending) echo "checking the exit through the tunnel" ;;
    stale) echo "the guard's state is old; is the guard running? (tunlock doctor)" ;;
    no_state) echo "no state from the guard; run install.sh" ;;
    *) echo "unknown" ;;
  esac
}

# The entry check only opens a TCP connection: it says nothing about the exit.
entry_desc() {
  case $(state_get entry_up) in
    up) echo "TCP port open" ;;
    down) echo "TCP port closed" ;;
    *) echo "TCP port not checked yet" ;;
  esac
}

# tunlock run [--timeout N] -- command [args]: start the command as you,
# only after the guard verified the exit for this very request. Exit 125
# when tunlock refuses, 126/127 when the command cannot run, otherwise the
# command's own status (it replaces this process: same pid, tty, signals).
RUN_REFUSED=125
cmd_run() {
  local timeout=30 quiet=0
  while (( $# )); do
    case $1 in
      -q | --quiet) quiet=1; shift ;;
      --timeout) [[ ${2:-} =~ ^[0-9]{1,4}$ ]] || { echo "tunlock run: --timeout takes seconds" >&2; return 2; }
                 timeout=$2; shift 2 ;;
      --) shift; break ;;
      *) echo "usage: tunlock run [--quiet] [--timeout SECONDS] -- command [args]" >&2; return 2 ;;
    esac
  done
  (( $# )) || { echo "usage: tunlock run [--quiet] [--timeout SECONDS] -- command [args]" >&2; return 2; }
  [[ $EUID != 0 ]] || { echo "tunlock run: run it as your user, without sudo" >&2; return "$RUN_REFUSED"; }
  local bin
  bin=$(PATH=$USER_PATH command -v -- "$1" || true)
  [[ -n $bin ]] || { echo "tunlock run: $1: command not found" >&2; return 127; }
  load_config >/dev/null
  run_refuse() { echo "tunlock run: not started: $*" >&2; return "$RUN_REFUSED"; }
  guard_running || { run_refuse "the guard is not running (tunlock doctor)"; return; }
  [[ -d $CHECK_DIR && -w $CHECK_DIR ]] || { run_refuse "the guard takes no checks; update and apply tunlock"; return; }
  local me hash deadline id ans reason='' got
  me=$(id -u)
  hash=$(conf_hash)
  deadline=$(( $(date +%s) + timeout ))
  while :; do
    id=$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')
    ( umask 022; : > "$CHECK_DIR/$id" ) || { run_refuse "cannot ask the guard for a check"; return; }
    ans=$ANSWER_DIR/$id got=0
    while (( $(date +%s) <= deadline )); do
      [[ -f $ans ]] && { got=1; break; }
      sleep 0.2
    done
    rm -f "$CHECK_DIR/$id" 2>/dev/null || true
    if (( ! got )); then
      # A reason from an earlier answer says more than the missing last one.
      if [[ -n $reason ]]; then run_refuse "$reason: $(reason_text "$reason") (still so after ${timeout}s)"
      else run_refuse "no answer from the guard within ${timeout}s"
      fi
      return
    fi
    run_get() { awk -F= -v k="$1" '$1 == k { sub(/^[^=]*=/, ""); print; exit }' "$ans"; }
    [[ $(run_get id) == "$id" && $(run_get uid) == "$me" ]] || { run_refuse "the answer is not for this request"; return; }
    [[ $(run_get config) == "$hash" ]] || { run_refuse "the configuration changed since the guard started; apply it first"; return; }
    reason=$(run_get reason)
    if [[ $(run_get mode) == protected && $(run_get probed) == 1 && $(run_get egress_ok) == 1 && $reason == ok ]]; then
      # The answer is this tick's; the state must still agree right now.
      [[ $(compute_verdict) == protected ]] && break
      reason=$(compute_reason)
    fi
    case $reason in
      # Waiting does not help: the user or the exit has to change.
      off | release_failed | pf_conflict | exit_mismatch)
        run_refuse "$reason: $(reason_text "$reason")"; return ;;
    esac
    (( $(date +%s) < deadline )) || { run_refuse "$reason: $(reason_text "$reason")"; return; }
    sleep 1
  done
  (( quiet )) || echo "tunlock run: exit $(run_get egress_ip) verified, starting $1" >&2
  export PATH=$USER_PATH
  exec "$bin" "${@:2}"
}

age() { local s=$1; (( s < 120 )) && echo "${s}s" || echo "$((s / 60))m"; }

cmd_status() {
  local porcelain=0
  [[ ${1:-} == --porcelain ]] && porcelain=1
  load_config >/dev/null
  if [[ ! -r $RUN_DIR/state ]]; then
    (( porcelain )) && { echo "verdict=unknown"; echo "reason=no_state"; return 3; }
    echo "No state from the guard. Is it installed and running? (tunlock doctor)"
    return 3
  fi
  local now updated mode phase tun ssh eip eok eat pfe pfr err verdict stale=0
  now=$(date +%s)
  updated=$(state_get updated); mode=$(state_get mode); phase=$(state_get phase)
  tun=$(state_get tun); ssh=$(state_get ssh); eip=$(state_get egress_ip)
  eok=$(state_get egress_ok); eat=$(state_get egress_at); pfe=$(state_get pf_enabled)
  pfr=$(state_get pf_rules); err=$(state_get error)
  (( now - ${updated:-0} <= 10 )) || stale=1
  verdict=$(compute_verdict)

  if (( porcelain )); then
    grep -v '^reason=' "$RUN_DIR/state" || true
    echo "stale=$stale"
    echo "verdict=$verdict"
    echo "reason=$(compute_reason)"
    status_code "$verdict"
    return
  fi
  local e_line="none"
  local echeck
  echeck=$(state_get egress_check)
  if [[ $eok == 1 ]]; then e_line="$eip (verified, $(age $((now - eat))) ago)"
  elif [[ $echeck == mismatch ]]; then e_line="$eip (NOT expected, $(age $((now - eat))) ago)"
  elif [[ $echeck == no_answer ]]; then e_line="no answer through the tunnel"
  elif [[ $echeck == pending ]]; then e_line="not verified yet"
  # A guard without egress_check: say only what the state proves.
  elif [[ -n $eip ]]; then e_line="$eip (not verified, $(age $((now - eat))) ago)"
  fi
  printf '%-8s %s\n' Mode "$mode"
  if [[ $(state_get upstream) == proxy ]]; then
    printf '%-8s %s\n' Proxy "$(entry_desc)  $(state_get entry)"
  else
    if [[ $(state_get cascade) == 1 ]]; then
      printf '%-8s %s\n' Entry "$(entry_desc)  $(state_get entry) (cascade)"
    fi
    printf '%-8s %s\n' SSH "$ssh  $(state_get ssh_endpoint)"
  fi
  local exp ec
  exp=$(state_get expected); ec=$(state_get expected_country)
  [[ $exp == any ]] && exp="any IP"
  printf '%-8s %s\n' Egress "$e_line  expected $exp${ec:+ in $ec}${tun:+  via $tun}"
  printf '%-8s %s\n' PF "phase $phase, pf $( [[ $pfe == 1 ]] && echo enabled || echo disabled ), $pfr rules in $(state_get pf_anchor)"
  [[ -z $(state_get bypass) ]] || printf '%-8s %s\n' Direct "$(state_get bypass) (around the tunnel)"
  if [[ $(state_get ai_closed) == 1 ]]; then
    printf '%-8s %s\n' Closed "$(state_get ai_nets) (AI services: only through the tunnel)"
  fi
  local reason
  reason=$(compute_reason)
  [[ $reason == ok || $reason == off ]] || printf '%-8s %s\n' Reason "$reason: $(reason_text "$reason")"
  [[ -z $err ]] || printf '%-8s %s\n' Error "$err"
  [[ -z $(state_get pf_conflict) ]] || printf '%-8s %s\n' Conflict "$(state_get pf_conflict)"
  [[ -z $(state_get warning) ]] || printf '%-8s %s\n' Warning "$(state_get warning)"
  case $verdict in
    protected) echo "=> PROTECTED: traffic leaves only through the verified tunnel" ;;
    blocked) echo "=> BLOCKED: no verified tunnel, direct traffic is dropped" ;;
    direct)
      echo "=> DIRECT: no kill switch, traffic leaves through your normal connection"
      [[ $(state_get ai_closed) != 1 ]] || echo "   except AI services (Claude): closed until tunlock is on" ;;
    unprotected) echo "=> NOT PROTECTED: protected mode is on but tunlock's pf rules are not (alone) in force" ;;
    error) echo "=> SWITCH FAILED: direct mode was asked, but tunlock rules could not be removed" ;;
    unknown) echo "=> UNKNOWN: guard state is $(age $((now - ${updated:-0}))) old; is the guard running?" ;;
  esac
  status_code "$verdict"
}

# 0 for a confirmed state (protected, blocked, direct), 1 unprotected, 3 unknown.
status_code() { case $1 in unprotected | error) return 1 ;; unknown) return 3 ;; *) return 0 ;; esac; }

# IPv6 reference runs, one line per network: "iface router reach(1|0) epoch".
# A protected run counts "no IPv6 answer" as blocked only where a direct run
# saw the same target answer: without that, the network may lack IPv6.
# One IPv6 network as a single token: interface, router, the router's
# link-layer address and the interface's /64 prefix. Routers often share
# fe80::1, so the router address alone does not tell two networks apart.
# Empty when the network cannot be told apart: no reference then.
ipv6_network() { # phys
  local gw mac prefix
  gw=$(route -n get -inet6 default 2>/dev/null | awk '$1 == "gateway:" { print $2; exit }')
  [[ -n $gw ]] || return 0
  mac=$(ndp -n "$gw" 2>/dev/null | awk 'NR > 1 && $2 ~ /^[0-9a-f]{1,2}(:[0-9a-f]{1,2}){5}$/ { print $2; exit }')
  prefix=$(ifconfig "$1" 2>/dev/null | awk '$1 == "inet6" && $2 !~ /^fe80/ && $2 !~ /^f[cd]/ {
      a = $2; sub(/%.*/, "", a); n = split(a, h, ":"); out = ""; k = 0
      for (i = 1; i <= n && k < 4; i++) {
        if (h[i] == "") { if (i > 1 && i < n) for (z = 0; z < 9 - n && k < 4; z++) { out = out (k ? ":" : "") "0"; k++ } ; continue }
        out = out (k ? ":" : "") h[i]; k++
      }
      while (k < 4) { out = out ":0"; k++ }
      print out; exit }')
  [[ -n $mac && -n $prefix ]] || return 0
  echo "$1|$gw|$mac|$prefix"
}
IPV6_BASELINE_TTL=86400  # a reference older than a day proves nothing
ipv6_baseline() { # network: 1, 0 or nothing
  [[ -n $1 ]] || return 0
  awk -v k="$1" -v now="$(date +%s)" -v ttl="$IPV6_BASELINE_TTL" \
    '$1 == k && now - $3 >= 0 && now - $3 <= ttl { r = $2 } END { if (r != "") print r }' \
    "$STATE_DIR/ipv6-baseline" 2>/dev/null || true
}
ipv6_baseline_save() { # network reach
  [[ -n $1 ]] || return 0
  local f=$STATE_DIR/ipv6-baseline tmp
  (umask 022; mkdir -p "$STATE_DIR")
  tmp=$(mktemp "$STATE_DIR/.ipv6-baseline.XXXXXX")
  { awk -v k="$1" '$1 != k && NF == 3' "$f" 2>/dev/null || true; echo "$1 $2 $(date +%s)"; } | tail -n 20 > "$tmp"
  chmod 644 "$tmp"; mv -f "$tmp" "$f"
}

# Live leak test. Every line is PASS (behaved as required), FAIL (leak or
# broken tunnel), SKIP (could not be checked here, with the reason) or INFO
# (direct mode: reference only). "No answer" proves blocking only when the
# target is known to answer: through the tunnel, or for IPv6 in a direct
# reference run on the same network. Otherwise the check is a SKIP.
# Protected runs end with UNCONFIRMED=<ipv4 udp ipv6, what this run could not
# prove blocked> and RESULT=pass|fail|incomplete; direct runs with
# RESULT=baseline. A required check that could not run gives incomplete.
cmd_test() {
  require_root
  load_config
  local phys mode ip r fails=0 missing=0 skipped=0 has6=0 unconfirmed=
  phys=$(physical_iface)
  mode=$(read_mode)
  echo "Mode: $mode, physical interface: ${phys:-none}, expected egress: $(expected_desc)"
  reach() { curl -gsS --noproxy '*' --connect-timeout 3 --max-time 5 -o /dev/null "$@" >/dev/null 2>&1; }
  trace() { # prints "ip country"
    curl -fsS --noproxy '*' --connect-timeout 4 --max-time 6 "$@" 2>/dev/null \
      | awk -F= '$1 == "ip" { ip = $2 } $1 == "loc" { loc = $2 } END { if (ip != "") print ip, loc }'
  }
  line() { printf '%-5s %-48s %s\n' "$1" "$2" "${3:-}"; }
  check() { # label want(ok|fail) got(ok|fail) detail
    local got=$3
    # Leak checks want no answer: say what happened, not ok/fail.
    if [[ $2 == fail ]]; then [[ $3 == fail ]] && got="no answer (blocked)" || got="answered directly"; fi
    if [[ $mode != protected ]]; then line INFO "$1" "$got${4:+ ($4)}"
    elif [[ $2 == "$3" ]]; then line PASS "$1" "$got${4:+ ($4)}"
    else line FAIL "$1" "$got${4:+ ($4)}"; fails=$((fails + 1))
    fi
  }
  skip() { # label reason required(1|0)
    line SKIP "$1" "$2"
    skipped=$((skipped + 1))
    [[ ${3:-0} == 1 && $mode == protected ]] && missing=$((missing + 1))
    return 0
  }
  unconfirm() { [[ " $unconfirmed " == *" $1 "* ]] || unconfirmed="${unconfirmed:+$unconfirmed }$1"; }
  # label what(ipv4|udp|ipv6) required reason: blocking could not be proven
  inconclusive() { skip "$1" "$4" "$3"; unconfirm "$2"; }

  if [[ $mode == protected ]]; then
    pf_enabled && pf_has_label "$(pfctl -a "$PF_ANCHOR" -sr 2>/dev/null | awk -F'"' '/label "tunlock-/ { print $2 }')" \
      && r=ok || r=fail
    check "pf enabled, tunlock rules loaded" ok "$r"
    local conflict
    conflict=$(pf_conflicts | head -1)
    [[ -z $conflict ]] && r=ok || r=fail
    check "no other pf rules decide before tunlock" ok "$r" "$conflict"
  fi
  local loc=''
  read -r ip loc <<< "$(trace -4 --interface "$TUN_ADDR" "$PROBE_URL" || true)"
  egress_matches "$ip" "$loc" && r=ok || r=fail
  local tun_ip=''
  [[ $r == ok ]] && tun_ip=$ip
  check "tunnel HTTPS by IP ($PROBE_IP)" ok "$r" "${ip:-no answer}${loc:+ $loc}"
  read -r ip loc <<< "$(trace -4 https://www.cloudflare.com/cdn-cgi/trace || true)"
  egress_matches "$ip" "$loc" && r=ok || r=fail
  check "HTTPS by name, system DNS and route" ok "$r" "${ip:-no answer}${loc:+ $loc}"

  # What AI services themselves see. A TUN app's routing rules may send these
  # hosts through another outbound than the probe. They sit behind Cloudflare,
  # so their own /cdn-cgi/trace says which address reached them.
  local host
  for host in $AI_HOSTS; do
    read -r ip loc <<< "$(trace -4 "https://$host/cdn-cgi/trace" || true)"
    if [[ -z $ip ]]; then
      line SKIP "$host sees" "no answer"
      skipped=$((skipped + 1))
    else
      egress_matches "$ip" "$loc" && r=ok || r=fail
      check "$host sees" ok "$r" "$ip${loc:+ $loc}"
    fi
  done

  # Which resolver answers the system's DNS. A fake-IP TUN app answers with
  # its own addresses (any range) and resolves inside the tunnel: a known name
  # with known addresses tells the two apart.
  local dns known
  known=$({ dig +short +time=3 +tries=1 one.one.one.one A 2>/dev/null || true; } | head -1)
  dns=$({ dig +short +time=3 +tries=1 whoami.akamai.net 2>/dev/null || true; } | head -1)
  if [[ -n $known && $known != 1.1.1.1 && $known != 1.0.0.1 ]]; then
    line INFO "DNS" "the TUN app answers DNS itself (fake-IP, e.g. $known): names resolve inside the tunnel"
  elif [[ -n $dns ]]; then
    line INFO "DNS resolver seen by Akamai" "$dns"
  else
    line INFO "DNS resolver" "no answer"
  fi

  # Sites can read the browser's time zone. Far from the exit's country, it stands out.
  local tz tzcc
  tz=$(readlink /etc/localtime 2>/dev/null | sed 's#.*/zoneinfo/##')
  tzcc=$(awk -v z="$tz" '!/^#/ && $3 == z { print $1; exit }' /usr/share/zoneinfo/zone.tab 2>/dev/null)
  if [[ -n $tzcc && -n $loc && $tzcc != "$loc" ]]; then
    line INFO "time zone" "$tz ($tzcc) differs from the exit country $loc: sites can see this"
  elif [[ -n $tz ]]; then
    line INFO "time zone" "$tz${tzcc:+ ($tzcc)}"
  fi

  if [[ -z $phys ]]; then
    skip "direct IPv4 / UDP / IPv6" "no Wi-Fi or Ethernet connection: blocking not confirmed" 1
    unconfirm ipv4; unconfirm udp; unconfirm ipv6
  else
    # Blocked means no answer on the physical link from a target that does
    # answer: through the tunnel (the default route in protected mode).
    reach -4 --interface "$phys" https://1.1.1.1/ && r=ok || r=fail
    if [[ $mode == protected && $r == fail ]] && ! reach -4 https://1.1.1.1/; then
      inconclusive "direct IPv4 TCP on $phys, no DNS" ipv4 1 \
        "no answer, but 1.1.1.1 does not answer through the tunnel either: blocking not confirmed"
    else
      check "direct IPv4 TCP on $phys, no DNS" fail "$r"
    fi
    # A raw DNS query for example.com over UDP, forced onto the physical link.
    local query='\x12\x34\x01\x00\x00\x01\x00\x00\x00\x00\x00\x00\x07example\x03com\x00\x00\x01\x00\x01'
    udp_dns() { printf '%b' "$query" | nc -u "$@" -w 2 1.1.1.1 53 2>/dev/null | wc -c; }
    (( $(udp_dns -b "$phys") > 0 )) && r=ok || r=fail
    # The control must come from 1.1.1.1 itself: a TUN app that answers DNS
    # on its own would answer anything. Cloudflare's whoami names the address
    # it saw, which through the tunnel is the verified exit.
    local seen
    # A timeout (dig exits 9) is no answer, never the end of the test.
    seen=$({ dig +short +time=2 +tries=1 @1.1.1.1 whoami.cloudflare CH TXT 2>/dev/null || true; } | tr -d '"' | head -1)
    if [[ $mode == protected && $r == fail ]] && [[ -z $tun_ip || $seen != "$tun_ip" ]]; then
      inconclusive "direct UDP DNS to 1.1.1.1 on $phys" udp 0 \
        "no answer, but 1.1.1.1 did not answer through the tunnel as itself (seen: ${seen:-nothing}): blocking not confirmed"
    else
      check "direct UDP DNS to 1.1.1.1 on $phys" fail "$r"
    fi
    ifconfig "$phys" | awk '$1 == "inet6" && $2 !~ /^fe80/ { f = 1 } END { exit !f }' && has6=1
    if (( has6 )); then
      local net base label
      net=$(ipv6_network "$phys")
      base=$(ipv6_baseline "$net")
      reach -6 --interface "$phys" 'https://[2606:4700:4700::1111]/' && r=ok || r=fail
      [[ $mode == protected ]] || ipv6_baseline_save "$net" "$([[ $r == ok ]] && echo 1 || echo 0)"
      for label in "direct IPv6 on $phys" "IPv6 over the default route"; do
        if [[ $label == "IPv6 over the default route" ]]; then
          reach -6 'https://[2606:4700:4700::1111]/' && r=ok || r=fail
        fi
        if [[ $mode != protected || $r == ok || $base == 1 ]]; then
          check "$label" fail "$r"
        elif [[ -z $net ]]; then
          inconclusive "$label" ipv6 0 "no answer, and this IPv6 network cannot be identified (router or prefix unknown): blocking not confirmed"
        elif [[ $base == 0 ]]; then
          inconclusive "$label" ipv6 0 "no answer, but IPv6 did not answer in the direct reference run here either: blocking not confirmed"
        else
          inconclusive "$label" ipv6 0 "no answer, but IPv6 was not seen working on this network in the last day: blocking not confirmed (reference: tunlock off, then sudo tunlock test)"
        fi
      done
    else
      skip "IPv6" "no IPv6 address on $phys: IPv6 blocking not confirmed on this network"
      unconfirm ipv6
    fi
  fi

  if [[ $mode != protected ]]; then
    echo "Direct mode: reference only, nothing is protected."
    if (( has6 )); then
      echo "IPv6 reference saved for this network: a protected run here can now confirm IPv6 is blocked."
    fi
    echo "RESULT=baseline"
    return 0
  fi
  echo "SKIPPED=$skipped"
  echo "UNCONFIRMED=$unconfirmed"
  if (( fails )); then echo "RESULT=fail"; return 1; fi
  if (( missing )); then echo "RESULT=incomplete"; return 3; fi
  echo "RESULT=pass"
}

cmd_doctor() {
  local ok=1
  item() { printf '%-4s %s\n' "$1" "$2"; [[ $1 == ok ]] || ok=0; }
  if (load_config) 2>/dev/null; then item ok "config $CONF"; else
    item bad "config: $( (load_config) 2>&1 || true)"; return 1
  fi
  load_config
  guard_running && item ok "guard running ($GUARD_LABEL)" || item bad "guard not loaded ($GUARD_LABEL)"
  local tun
  if [[ $UPSTREAM == proxy ]]; then
    tun=$(find_tun || true)
    [[ -n $tun ]] && item ok "TUN $TUN_ADDR on $tun" || item bad "no utun with $TUN_ADDR (TUN client off?)"
    entry_up && item ok "proxy $ENTRY_HOST:$ENTRY_PORT reachable outside the tunnel" \
      || item bad "proxy $ENTRY_HOST:$ENTRY_PORT not reachable outside the tunnel"
    if [[ $EUID == 0 ]]; then
      pf_anchor_reachable && item ok "root pf ruleset reaches $PF_ANCHOR" || item bad "root pf ruleset does not reach $PF_ANCHOR"
    else echo "--   run with sudo to check pf"; fi
    (( ok ))
    return
  fi
  local u=${SUDO_UID:-$EUID}
  if launchctl print "gui/$u/$SSH_LABEL" >/dev/null 2>&1; then item ok "ssh agent loaded ($SSH_LABEL)"
  else item bad "ssh agent not loaded for uid $u ($SSH_LABEL)"; fi
  ssh_up && item ok "forward listening on $HEALTH_HOST:$HEALTH_PORT" \
    || item bad "nothing listens on $HEALTH_HOST:$HEALTH_PORT"
  tun=$(find_tun || true)
  [[ -n $tun ]] && item ok "TUN $TUN_ADDR on $tun" || item bad "no utun with $TUN_ADDR (TUN client off?)"
  local kh="$HOME/.ssh/known_hosts"
  if [[ -n ${SUDO_USER:-} ]]; then
    kh=$(dscl . -read "/Users/$SUDO_USER" NFSHomeDirectory | awk '{ print $2 }')/.ssh/known_hosts
  fi
  local h hosts=$SSH_HOST
  [[ -z $JUMP_HOST ]] || hosts="$JUMP_HOST $SSH_HOST"
  for h in $hosts; do
    if ssh-keygen -F "$h" -f "$kh" >/dev/null 2>&1 || ssh-keygen -F "[$h]:$SSH_PORT" -f "$kh" >/dev/null 2>&1 \
      || ssh-keygen -F "[$h]:$JUMP_PORT" -f "$kh" >/dev/null 2>&1; then
      item ok "host key for $h is in known_hosts"
    else item bad "no host key for $h in $kh (StrictHostKeyChecking is on)"; fi
  done
  entry_up && item ok "SSH entry $ENTRY_HOST:$ENTRY_PORT reachable outside the tunnel" \
    || item bad "SSH entry $ENTRY_HOST:$ENTRY_PORT not reachable outside the tunnel"
  if [[ $EUID == 0 ]]; then
    pf_anchor_reachable && item ok "root pf ruleset reaches $PF_ANCHOR" \
      || item bad "root pf ruleset does not reach $PF_ANCHOR"
  else
    echo "--   run with sudo to check pf"
  fi
  (( ok ))
}

cmd_config() {
  local key
  for key in $CONFIG_KEYS PROBE_IP HEALTH_HOST HEALTH_PORT ENTRY_HOST ENTRY_PORT; do echo "$key=${!key}"; done
  echo "TUN_IFACE=$(find_tun || true)"
}

usage() {
  cat <<EOF
tunlock $VERSION: SSH tunnel keeper with a pf kill switch for macOS

  tunlock on          protect: rules first, then SSH and the TUN client; fails closed
  tunlock off         everything off: no rules, SSH port freed, TUN client stopped;
                      asks first while AI clients run (--force: don't ask)
  tunlock ai-clients  running AI clients that would reconnect directly once off
                      (protect / direct are the same commands)
  tunlock status      SSH, verified egress IP and pf state  [--porcelain]
  tunlock run [--quiet] [--timeout N] -- command [args]
                      start command as you, only after a fresh check of the exit;
                      exit 125 when refused, else the command's own status
  tunlock test        live leak test (sudo)
  tunlock doctor      check the installation
  tunlock conflicts   pf rules that would decide before tunlock (sudo)
  tunlock config      print the effective configuration
  tunlock ssh-command print the ssh command the keeper runs, change nothing
  tunlock render-rules block|probe|open [utunN [enN]]   print pf rules, change nothing

Config: $CONF
EOF
}

main() {
  local cmd=${1:-}
  shift || true
  case $cmd in
    protect | on) cmd_protect "$@" ;;
    direct | off) cmd_direct "$@" ;;
    status) cmd_status "$@" ;;
    ai-clients) ai_clients ;;
    run) cmd_run "$@" ;;
    test) cmd_test "$@" ;;
    doctor) cmd_doctor "$@" ;;
    guard) cmd_guard ;;
    cleanup) cmd_cleanup ;;
    conflicts)  # pf rules that decide before tunlock's anchor; exit 1 if any
      require_root; load_config
      out=$(pf_conflicts)
      if [[ -z $out ]]; then echo "none"; else echo "$out"; exit 1; fi ;;
    _guard-ticks)  # tests: run N guard ticks against stubs, then stop
      test_only
      load_config; guard_init
      for (( n = 0; n < ${1:-1}; n++ )); do
        guard_tick; write_state; checks_answer
        [[ -z ${TUNLOCK_TEST_BETWEEN:-} ]] || "$TUNLOCK_TEST_BETWEEN" "$n"
      done ;;
    _sync-resolvers) test_only; load_config; G_WARNING=''; sync_resolvers; echo "warning=$G_WARNING" ;;  # tests
    ssh-run) cmd_ssh_run ;;
    ssh-command)
      load_config
      [[ $UPSTREAM != proxy ]] || { echo "none: UPSTREAM=proxy runs no SSH"; exit 0; }
      build_ssh_args "$(physical_iface)"; printf '%q ' "${SSH_ARGS[@]}"; echo ;;
    render-rules) load_config; render_rules "${1:-block}" "${2:-}" "${3-$(physical_iface)}" ;;
    config) load_config; cmd_config ;;
    version | --version) echo "tunlock $VERSION" ;;
    help | -h | --help | '') usage ;;
    *) usage >&2; exit 2 ;;
  esac
}

main "$@"
